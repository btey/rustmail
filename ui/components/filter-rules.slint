import { VerticalBox, HorizontalBox, ComboBox, CheckBox } from "std-widgets.slint";
import { Button } from "button.slint";
import { LineEdit } from "controls.slint";
import { AppTheme } from "../design-system.slint";
import { TypeScale } from "../typography.slint";

export struct FilterRuleRow {
    id: string,
    name: string,
    summary: string,
    enabled: bool,
}

// One row of the rule editor. `field`, `op` and `kind` are positions in the
// lists of the same names in src/filter_rules_controller.rs.
export struct FilterConditionEdit {
    field: int,
    op: int,
    name: string,
    value: string,
}

export struct FilterActionEdit {
    kind: int,
    value: string,
}

// Filter rules (conditions and actions applied to incoming mail). The Rust
// side keeps these in step with the saved settings.
export global FilterRules {
    in-out property <[FilterRuleRow]> rows;
    in-out property <string> status;
    // Result of the last "run now", shown next to its button.
    in-out property <string> run-status;
    in-out property <bool> busy: false;
    // The rule being written.
    in-out property <string> edit-name;
    in-out property <bool> edit-match-all: true;
    in-out property <bool> edit-stop: false;
    in-out property <[FilterConditionEdit]> edit-conditions: [{ field: 0, op: 0, name: "", value: "" }];
    in-out property <[FilterActionEdit]> edit-actions: [{ kind: 0, value: "" }];
    callback context-changed();
    callback add-rule();
    callback delete-rule(string);
    callback toggle-rule(string);
    callback move-rule(string, int);
    callback run-now();
    callback add-condition();
    callback remove-condition(int);
    callback update-condition(int, FilterConditionEdit);
    callback add-action();
    callback remove-action(int);
    callback update-action(int, FilterActionEdit);
}

component ConditionRow inherits HorizontalBox {
    in property <FilterConditionEdit> data;
    in property <bool> enabled: true;
    in property <bool> can-remove: true;
    callback changed(FilterConditionEdit);
    callback remove();
    // 0 text, 1 header, 2 number (age, size), 3 yes/no
    private property <int> kind: root.data.field == 4 ? 1 : root.data.field <= 5 ? 0 : root.data.field <= 7 ? 2 : 3;
    padding: 0px;
    spacing: 8px;
    height: 36px;

    ComboBox {
        width: 150px;
        enabled: root.enabled;
        model: [@tr("From"), @tr("To"), @tr("Cc"), @tr("Subject"), @tr("Header"), @tr("Body"), @tr("Age"), @tr("Size"), @tr("Is read"), @tr("Is starred"), @tr("Has attachment"), @tr("Mailing list")];
        current-index: root.data.field;
        selected(value) => {
            root.changed({ field: self.current-index, op: 0, name: root.data.name, value: "" });
        }
    }
    if root.kind <= 1 : ComboBox {
        width: 170px;
        enabled: root.enabled;
        model: [@tr("contains"), @tr("does not contain"), @tr("is exactly"), @tr("starts with"), @tr("ends with"), @tr("matches regex")];
        current-index: root.data.op;
        selected(value) => {
            root.changed({ field: root.data.field, op: self.current-index, name: root.data.name, value: root.data.value });
        }
    }
    if root.kind == 2 : ComboBox {
        width: 170px;
        enabled: root.enabled;
        model: root.data.field == 6 ? [@tr("older than (days)"), @tr("newer than (days)")] : [@tr("larger than (KB)"), @tr("smaller than (KB)")];
        current-index: root.data.op;
        selected(value) => {
            root.changed({ field: root.data.field, op: self.current-index, name: root.data.name, value: root.data.value });
        }
    }
    if root.kind == 3 : ComboBox {
        width: 170px;
        enabled: root.enabled;
        model: [@tr("yes"), @tr("no")];
        current-index: root.data.op;
        selected(value) => {
            root.changed({ field: root.data.field, op: self.current-index, name: root.data.name, value: root.data.value });
        }
    }
    if root.kind == 1 : LineEdit {
        width: 150px;
        enabled: root.enabled;
        text: root.data.name;
        input-label: @tr("Header name");
        placeholder-text: @tr("Header, e.g. X-Spam-Flag");
        edited(text) => {
            root.changed({ field: root.data.field, op: root.data.op, name: text, value: root.data.value });
        }
    }
    if root.kind != 3 : LineEdit {
        horizontal-stretch: 1;
        enabled: root.enabled;
        text: root.data.value;
        input-label: @tr("Condition value");
        placeholder-text: root.kind == 2 ? (root.data.field == 6 ? @tr("Number of days") : @tr("Size in KB")) : root.data.op == 5 ? @tr("Regular expression") : @tr("Text to look for");
        edited(text) => {
            root.changed({ field: root.data.field, op: root.data.op, name: root.data.name, value: text });
        }
    }
    Button {
        width: 36px;
        text: "×";
        enabled: root.enabled && root.can-remove;
        clicked => { root.remove(); }
    }
}

component ActionRow inherits HorizontalBox {
    in property <FilterActionEdit> data;
    in property <bool> enabled: true;
    in property <bool> can-remove: true;
    callback changed(FilterActionEdit);
    callback remove();
    padding: 0px;
    spacing: 8px;
    height: 36px;

    ComboBox {
        width: 230px;
        enabled: root.enabled;
        model: [@tr("Mark as read"), @tr("Mark as unread"), @tr("Star"), @tr("Archive"), @tr("Mark as spam"), @tr("Move to trash"), @tr("Move to folder"), @tr("Add label"), @tr("Copy to folder"), @tr("Forward to address"), @tr("Run command")];
        current-index: root.data.kind;
        selected(value) => {
            root.changed({ kind: self.current-index, value: "" });
        }
    }
    if root.data.kind >= 6 : LineEdit {
        horizontal-stretch: 1;
        enabled: root.enabled;
        text: root.data.value;
        input-label: @tr("Action value");
        placeholder-text: root.data.kind == 6 || root.data.kind == 8 ? @tr("Folder name, for example Receipts") : root.data.kind == 7 ? @tr("Label name") : root.data.kind == 9 ? @tr("Address, for example me@example.org") : @tr("Command; %f is the message file");
        edited(text) => {
            root.changed({ kind: root.data.kind, value: text });
        }
    }
    Button {
        width: 36px;
        text: "×";
        enabled: root.enabled && root.can-remove;
        clicked => { root.remove(); }
    }
}

export component FilterRulesSettings inherits VerticalBox {
    in property <bool> compact: false;
    in property <color> heading-color;
    in property <color> secondary-text;
    in property <color> border-color;
    padding: 0px;
    spacing: 10px;

    Text {
        height: max(20px, self.preferred-height);
        text: @tr("Your filters");
        color: root.heading-color;
        font-size: TypeScale.secondary;
        font-weight: 600;
    }
    Text {
        text: @tr("Filters run on new mail that arrives in an Inbox, in the order shown. Move, label and flag actions apply to the whole conversation; copy, forward and run-command act on the message itself. Mail already in your account is not changed unless you run the filters by hand.");
        color: root.secondary-text;
        font-size: TypeScale.caption;
        wrap: word-wrap;
        height: self.preferred-height;
    }
    if FilterRules.rows.length == 0 : Text {
        height: max(18px, self.preferred-height);
        text: @tr("No filters yet.");
        color: root.secondary-text;
        font-size: TypeScale.caption;
    }
    for row[index] in FilterRules.rows : Rectangle {
        height: 58px;
        border-radius: 8px;
        border-width: 1px;
        border-color: root.border-color;
        opacity: row.enabled ? 1 : 0.55;
        HorizontalBox {
            padding-left: 12px;
            padding-right: 8px;
            spacing: 6px;
            VerticalBox {
                horizontal-stretch: 1;
                padding: 0px;
                spacing: 2px;
                alignment: center;
                Text { text: row.name; color: root.heading-color; font-size: TypeScale.secondary; font-weight: 600; overflow: elide; }
                Text { text: row.summary; color: root.secondary-text; font-size: TypeScale.caption; overflow: elide; }
            }
            Button { width: 40px; text: "↑"; enabled: !FilterRules.busy && index > 0; clicked => { FilterRules.move-rule(row.id, -1); } }
            Button { width: 40px; text: "↓"; enabled: !FilterRules.busy && index < FilterRules.rows.length - 1; clicked => { FilterRules.move-rule(row.id, 1); } }
            Button { width: max(88px, self.content-width + 24px); text: row.enabled ? @tr("Turn off") : @tr("Turn on"); enabled: !FilterRules.busy; clicked => { FilterRules.toggle-rule(row.id); } }
            Button { width: max(76px, self.content-width + 24px); text: @tr("Delete"); enabled: !FilterRules.busy; clicked => { FilterRules.delete-rule(row.id); } }
        }
    }
    HorizontalBox {
        padding: 0px;
        height: 34px;
        alignment: start;
        Button {
            width: max(200px, self.content-width + 28px);
            text: @tr("Run filters on the Inboxes now");
            enabled: !FilterRules.busy && FilterRules.rows.length > 0;
            clicked => { FilterRules.run-now(); }
        }
    }
    if FilterRules.run-status != "" : Text {
        text: FilterRules.run-status;
        color: root.secondary-text;
        font-size: TypeScale.caption;
        wrap: word-wrap;
        height: self.preferred-height;
    }
    Rectangle { height: 1px; background: root.border-color; }

    Text {
        height: max(20px, self.preferred-height);
        text: @tr("New filter");
        color: root.heading-color;
        font-size: TypeScale.secondary;
        font-weight: 600;
    }
    LineEdit {
        height: 36px;
        enabled: !FilterRules.busy;
        text <=> FilterRules.edit-name;
        input-label: @tr("Filter name");
        placeholder-text: @tr("Name, for example Receipts");
    }
    HorizontalBox {
        padding: 0px;
        height: 36px;
        spacing: 8px;
        alignment: start;
        Text { text: @tr("Apply when"); color: root.secondary-text; font-size: TypeScale.caption; vertical-alignment: center; }
        ComboBox {
            width: 150px;
            enabled: !FilterRules.busy;
            model: [@tr("all"), @tr("any")];
            current-index: FilterRules.edit-match-all ? 0 : 1;
            selected(value) => { FilterRules.edit-match-all = self.current-index == 0; }
        }
        Text { text: @tr("of these match:"); color: root.secondary-text; font-size: TypeScale.caption; vertical-alignment: center; }
    }
    for condition[index] in FilterRules.edit-conditions : ConditionRow {
        data: condition;
        enabled: !FilterRules.busy;
        can-remove: FilterRules.edit-conditions.length > 1;
        changed(edited) => { FilterRules.update-condition(index, edited); }
        remove => { FilterRules.remove-condition(index); }
    }
    HorizontalBox {
        padding: 0px;
        height: 34px;
        alignment: start;
        Button {
            width: max(120px, self.content-width + 28px);
            text: @tr("Add condition");
            enabled: !FilterRules.busy && FilterRules.edit-conditions.length < 8;
            clicked => { FilterRules.add-condition(); }
        }
    }
    Text {
        height: max(20px, self.preferred-height);
        text: @tr("Then:");
        color: root.secondary-text;
        font-size: TypeScale.caption;
    }
    for action[index] in FilterRules.edit-actions : ActionRow {
        data: action;
        enabled: !FilterRules.busy;
        can-remove: FilterRules.edit-actions.length > 1;
        changed(edited) => { FilterRules.update-action(index, edited); }
        remove => { FilterRules.remove-action(index); }
    }
    HorizontalBox {
        padding: 0px;
        height: 34px;
        alignment: start;
        Button {
            width: max(120px, self.content-width + 28px);
            text: @tr("Add action");
            enabled: !FilterRules.busy && FilterRules.edit-actions.length < 6;
            clicked => { FilterRules.add-action(); }
        }
    }
    CheckBox {
        text: @tr("Stop: skip the filters below when this one matches");
        enabled: !FilterRules.busy;
        checked: FilterRules.edit-stop;
        toggled => { FilterRules.edit-stop = self.checked; }
    }
    HorizontalBox {
        padding: 0px;
        height: 34px;
        alignment: start;
        Button {
            width: max(120px, self.content-width + 28px);
            primary: true;
            text: @tr("Add filter");
            enabled: !FilterRules.busy && FilterRules.edit-name != "";
            clicked => { FilterRules.add-rule(); }
        }
    }
    if FilterRules.status != "" : Text {
        text: FilterRules.status;
        color: root.secondary-text;
        font-size: TypeScale.caption;
        wrap: word-wrap;
        height: self.preferred-height;
    }
}
