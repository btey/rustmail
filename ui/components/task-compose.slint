// The "Tasks" settings; the app loads them at start and writes changes back.
export global TaskSettingsUi {
    // 0 four days, 1 two days, 2 one week, 3 never (see TaskComposeUi.follow-up).
    in-out property <int> follow-up: 0;
    // "Archive email once the task exists" starts ticked.
    in-out property <bool> archive: false;
    // Defaults of "New task from email". The choice lists come from the task
    // database (entry 0 means "first project" / "no context"); `project` and
    // `context` hold the chosen names, empty for entry 0.
    in-out property <[string]> project-choices: [];
    in-out property <[string]> context-choices: [];
    in-out property <string> project: "";
    in-out property <string> context: "";
    in-out property <int> project-index: 0;
    in-out property <int> context-index: 0;
    // 0 inbox, 1 next, 2 waiting, 3 scheduled.
    in-out property <int> status-index: 0;
    // Columns a new project starts with: 0 all six, 1 simple (four).
    in-out property <int> columns-index: 0;
    // Ctrl+Shift+<key> opens "New task from email"; empty = off. 0 K, 1 T, 2 off.
    in-out property <int> shortcut-index: 0;
    in-out property <string> shortcut-key: "k";
    in-out property <string> shortcut-key-upper: "K";
    // Some platforms send Ctrl+letter as the control character (K = U+000B).
    in-out property <string> shortcut-key-control;
    callback save-shortcut(int);
    callback save-columns(int);
    callback save-follow-up(int);
    callback save-archive(bool);
    callback save-project(int);
    callback save-context(int);
    callback save-status(int);
}

// State of the composer's "email from a task" options. The values are
// indexes; the app owns them and the labels live in composer-actions.slint.
// "Send later" in the composer: the menu choice the next send is scheduled
// for ("1h" | "4h" | "tomorrow" | "monday"), empty to send now. The app reads
// and clears it when the send is submitted.
export global ComposeScheduleUi {
    in-out property <string> when: "";
}

export global TaskComposeUi {
    // True while the open composer will link its mail to a task.
    in-out property <bool> active: false;
    // 0 Waiting for, 1 Keep in place, 2 Done.
    in-out property <int> after: 0;
    // 0 four days, 1 two days, 2 one week, 3 no follow-up.
    in-out property <int> follow-up: 0;
    // The follow-up date the choice above works out to (YYYY-MM-DD); empty for never.
    in-out property <string> follow-up-date: "";
    // Title of the task whose mail was just sent and linked; empty hides the card.
    in-out property <string> sent-title: "";
    // What happened besides the link, for the card: 0 nothing, 1 moved to
    // Waiting for, 2 marked done; follow-up days (0 none); event booked.
    in-out property <int> sent-moved: 0;
    in-out property <int> sent-follow-up-days: 0;
    in-out property <bool> sent-event: false;
    // Height of the card: one 22px line for each thing that happened.
    out property <length> card-height: 96px + 22px * ((sent-moved > 0 ? 1 : 0) + (sent-follow-up-days > 0 ? 1 : 0) + (sent-event ? 1 : 0));
    callback cycle-after();
    callback cycle-follow-up();
}
