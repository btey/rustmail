import { ScrollView } from "std-widgets.slint";
import { AppTheme } from "../design-system.slint";
import { TypeScale } from "../typography.slint";
import { Button } from "../components/button.slint";
import { ScheduledUi } from "../components/task-compose.slint";

// Messages held for a later time ("Send later"), with a way to cancel each.
export component ScheduledDialog inherits Rectangle {
    background: #00000066;
    accessible-role: groupbox;
    accessible-label: @tr("Scheduled messages");

    TouchArea { }

    card := Rectangle {
        width: min(560px, parent.width - 32px);
        height: min(parent.height - 32px, 176px + max(1, ScheduledUi.rows.length) * 60px);
        x: (parent.width - self.width) / 2;
        y: max(16px, (parent.height - self.height) / 2);
        border-radius: 12px;
        border-width: 1px;
        border-color: AppTheme.border;
        background: AppTheme.surface;

        Text {
            x: 22px;
            y: 18px;
            width: parent.width - 44px;
            height: 34px;
            text: @tr("Scheduled messages");
            color: AppTheme.title;
            font-size: TypeScale.heading;
            font-weight: 700;
            overflow: elide;
        }
        Text {
            x: 22px;
            y: 54px;
            width: parent.width - 44px;
            height: 24px;
            text: ScheduledUi.error != "" ? ScheduledUi.error
                : ScheduledUi.rows.length == 0 ? @tr("No message is waiting to be sent.")
                : @tr("Cancelling keeps the message as a draft. The app must be running at the time.");
            color: ScheduledUi.error != "" ? AppTheme.destructive : AppTheme.secondary;
            font-size: TypeScale.caption;
            overflow: elide;
        }
        ScrollView {
            x: 22px;
            y: 86px;
            width: parent.width - 44px;
            height: parent.height - 86px - 64px;
            horizontal-scrollbar-policy: always-off;
            content-height: ScheduledUi.rows.length * 60px;
            for row[index] in ScheduledUi.rows : Rectangle {
                y: index * 60px;
                width: parent.width;
                height: 60px;
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: AppTheme.border;
                }
                Text {
                    x: 0px;
                    y: 4px;
                    width: parent.width - 190px;
                    height: 28px;
                    text: row.subject != "" ? row.subject : @tr("(No subject)");
                    color: AppTheme.heading;
                    font-size: TypeScale.body;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    x: 0px;
                    y: 32px;
                    width: parent.width - 190px;
                    height: 24px;
                    text: row.when + " · " + row.to;
                    color: AppTheme.secondary;
                    font-size: TypeScale.caption;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Button {
                    x: parent.width - self.width;
                    y: 12px;
                    height: 32px;
                    width: max(138px, self.content-width + 28px);
                    text: @tr("Cancel send");
                    clicked => { ScheduledUi.cancel(row.action-id); }
                }
            }
        }
        Button {
            x: parent.width - self.width - 22px;
            y: parent.height - 52px;
            height: 34px;
            width: max(96px, self.content-width + 28px);
            text: @tr("Close");
            primary: true;
            clicked => { ScheduledUi.open = false; }
        }
    }
}
