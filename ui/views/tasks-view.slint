import { ScrollView } from "std-widgets.slint";
import { AppTheme, LayoutMetrics } from "../design-system.slint";
import { TypeScale } from "../typography.slint";
import { Button } from "../components/button.slint";
import { ActionMenu, ActionMenuEntry } from "../components/action-menu.slint";
import { LineEdit, TextEdit, ToolbarIconButton } from "../components/controls.slint";
import { SidebarItem } from "../components/sidebar-controls.slint";
import { CollapsibleWorkspaceSidebar, WorkspaceMiniHeading } from "../components/workspace-layout.slint";
import { DetailEmptyState } from "../components/detail-empty-state.slint";
import { TaskComposeUi } from "../components/task-compose.slint";
import { TabsUi } from "../components/workspace-navigation.slint";

export struct TaskCardRow {
    id: int,
    title: string,
    // The title with a line through every letter (U+0336), for a done task; empty otherwise.
    struck-title: string,
    due: string,
    // "today" or "tomorrow" when the due date is that day, else empty.
    due-kind: string,
    // Initials of the other people on the task, after the first avatar.
    more-assignees: [string],
    // Date a sent mail should be followed up, empty when none or done.
    follow-up: string,
    due-warn: bool,
    high-priority: bool,
    labels: string,
    // The same labels one by one, for the chips on the card.
    label-list: [string],
    checklist-total: int,
    checklist-done: int,
    link-count: int,
    done: bool,
    from-mail: bool,
    context: string,
    assignee: string,
    status: string,
    // Whole days since the sent mail; -1 = not waiting on a reply.
    no-reply-days: int,
    // The newest thing that happened is a reply to the linked mail.
    replied: bool,
    // Typed straight into the board and still in the Inbox.
    quick-capture: bool,
    // The first linked mail or event: "mail_received" | "mail_sent" | "event"
    // with its text, empty when the task has none.
    link-kind: string,
    link-text: string,
    /// Other linked mails and events beyond the one shown.
    link-more: int,
}

export struct PickerDayRow {
    label: string,
    // ISO date, sent back when the day is chosen.
    date: string,
    in-month: bool,
    today: bool,
    selected: bool,
}

export struct TimelineDayRow {
    // Day of the month.
    label: string,
    weekend: bool,
    today: bool,
    // "W36" on a Monday, empty otherwise.
    week: string,
    // "November 2026"; the toolbar names the month in the middle of the view.
    month: string,
}

export struct TimelinePinRow {
    day: int,
    // "mail" | "sent" | "event"
    kind: string,
}

export struct TimelineLinkRow {
    kind: string,
    text: string,
}

export struct TimelineBarRow {
    id: int,
    title: string,
    // The title with a strike-through, set for done tasks.
    struck-title: string,
    start-text: string,
    due-text: string,
    // Day indexes, inclusive.
    first-day: int,
    last-day: int,
    // Only one date is set: drawn as a diamond.
    milestone: bool,
    done: bool,
    overdue: bool,
    // Days past the due date for an overdue task, else 0.
    late-days: int,
    // Days since a sent mail got no reply, -1 when the task is not waiting.
    no-reply-days: int,
    // The board column's colour, used when the tasks are grouped by column.
    coloured: bool,
    group-colour: color,
    // Checklist progress, 0 to 100.
    progress: int,
    // Linked mail received, mail sent and events, for the LINKS column.
    has-mail: bool,
    has-sent: bool,
    has-event: bool,
    // A group row (one board column) with a summary bar.
    group: bool,
    // The group's board column, and whether its tasks are folded away.
    column-id: int,
    collapsed: bool,
    // The board column's name and the calendar days the bar covers.
    status: string,
    day-count: int,
    // Day index where the wait for a reply starts, -1 when not waiting.
    waiting-from: int,
    pins: [TimelinePinRow],
    links: [TimelineLinkRow],
}

export struct TimelineEventRow {
    // "09:30 Title"
    label: string,
    // Day indexes, inclusive.
    first-day: int,
    last-day: int,
    // Row in the events lane.
    lane: int,
    // Calendar row id, the first day as YYYY-MM-DD, made in Rustmail, and the
    // calendar's colour.
    id: int,
    date: string,
    local: bool,
    coloured: bool,
    colour: color,
}

export struct TimelineEdgeRow {
    // Indexes into the bars: the prerequisite and the task that waits for it.
    from-bar: int,
    to-bar: int,
}

export struct TaskColumnRow {
    // -1 for the synthetic list shown by focus, context and search views.
    id: int,
    name: string,
    // Icon token: one of the `icon:` entries of the column menu.
    icon: string,
    colour: color,
    count: string,
    over-wip: bool,
    collapsed: bool,
    // 0 = no limit.
    wip-limit: int,
    // Built-in column: cannot be deleted.
    fixed: bool,
    cards: [TaskCardRow],
}

export struct TaskChipRow {
    key: string,
    text: string,
}

export struct TaskNavRow {
    key: string,
    label: string,
    count: string,
    colour: color,
}

export struct TaskDetailRow {
    id: int,
    move-back: bool,
    title: string,
    description: string,
    due: string,
    // First day of work (YYYY-MM-DD), empty when unset.
    start: string,
    high-priority: bool,
    done: bool,
    project: string,
    column: string,
    context: string,
    assignee: string,
    labels: string,
    // Days since the sent mail with no reply, -1 when not waiting.
    waiting-days: int,
    // Date to follow up a sent mail (YYYY-MM-DD), empty when unset.
    follow-up: string,
    // Percentage complete set by hand, -1 when it follows the checklist.
    percent: int,
    // Icon token of the task's column, for the Status row.
    column-icon: string,
    // Conversation the primary button replies to, -1 when it does not.
    reply-thread: int,
    reply-subject: string,
}

export struct ChecklistRow {
    id: int,
    text: string,
    // `text` with a line through it, shown while the item is done.
    struck: string,
    done: bool,
}

export struct TaskLabelRow {
    id: int,
    name: string,
    colour: color,
    hex: string,
    applied: bool,
    // False while the search box filters this label out.
    shown: bool,
}

// Where a label chip goes in the drawer: its wrapped position, and the
// height of all the chips together (the same in every entry).
export struct ChipPos {
    x: length,
    y: length,
    h: length,
}

export struct LinkRow {
    id: int,
    // "task:<id>" for a linked task, "mail:<thread id>" for a mail, empty otherwise.
    open: string,
    // The conversation a found mail link points at, -1 for other links.
    thread-id: int,
    // "mail_received" | "mail_sent" | "event" | "task_blocks" | "task_depends"
    kind: string,
    text: string,
    found: bool,
    // "done" / "open" for a linked task, the start day for an event.
    note: string,
}

export struct ActivityRow {
    kind: string,
    text: string,
    at: string,
}

export global TasksUi {
    in-out property <TaskDetailRow> detail;
    // Steps still to come in the link trail: a reply, a follow-up.
    out property <bool> trail-pending: detail.waiting-days >= 0 || (detail.follow-up != "" && !detail.done);
    // The open task's labels, one chip each.
    in-out property <[string]> detail-labels;
    in-out property <bool> detail-open: false;
    // The drawer's date picker: month shown ("YYYY-MM"), its title, 6 x 7 days.
    in-out property <bool> picker-open: false;
    in-out property <string> picker-month;
    in-out property <string> picker-title;
    in-out property <[PickerDayRow]> picker-days;
    // The open task fills the page: form on the left, link trail on the right.
    in-out property <bool> detail-expanded: false;
    in-out property <[ChecklistRow]> checklist;
    in-out property <int> checklist-done: 0;
    in-out property <[LinkRow]> links;
    in-out property <[ActivityRow]> activity;
    callback save-detail(string, string, string, string);
    // Write an email from the task: task id, title.
    callback email-task(int, string);
    in-out property <[TaskColumnRow]> columns;
    in-out property <[TaskNavRow]> focus-rows;
    in-out property <[TaskNavRow]> projects;
    in-out property <[TaskNavRow]> contexts;
    // Card menu: one "move:<column id>" entry per column of the open project.
    in-out property <[ActionMenuEntry]> card-menu;
    // Every project, for the drawer's Project row (ids are project keys).
    in-out property <[ActionMenuEntry]> project-menu;
    // Drawer pickers: "ctx:<id>" / "ctx:none" and "lbl:<id>" entries.
    in-out property <bool> list-mode: false;
    // Order of a flat list: "manual", "due", "due-reversed", "priority", ...
    in-out property <string> sort: "manual";
    in-out property <bool> can-switch-view: false;
    in-out property <[ActionMenuEntry]> group-menu;
    // The name of a Group menu entry (a grouping or "sort:<order>").
    pure callback group-title(string) -> string;
    group-title(id) => {
        return id == "none" ? @tr("No grouping")
        : id == "status" ? @tr("Group by status")
        : id == "project" ? @tr("Group by project")
        : id == "context" ? @tr("Group by context")
        : id == "label" ? @tr("Group by label")
        : id == "due" ? @tr("Group by due date")
        : id == "sort:manual" ? @tr("Manual order")
        : id == "sort:due" ? @tr("Sort by due date")
        : id == "sort:priority" ? @tr("Sort by priority")
        : id == "sort:title" ? @tr("Sort by title")
        : id;
    }
    // The name of a section of a grouped list: the due-date and "none" sections
    // are fixed English names from the controller; other names are the user's.
    pure callback section-title(string) -> string;
    section-title(name) => {
        return name == "Overdue" ? @tr("Overdue")
        : name == "Today" ? @tr("Today")
        : name == "Next 7 days" ? @tr("Next 7 days")
        : name == "Later" ? @tr("Later")
        : name == "No due date" ? @tr("No due date")
        : name == "No context" ? @tr("No context")
        : name == "No label" ? @tr("No label")
        : name;
    }
    in-out property <[ActionMenuEntry]> assignee-menu;
    pure callback due-kind-title(string) -> string;
    due-kind-title(kind) => { return kind == "today" ? @tr("Today") : @tr("Tomorrow"); }
    // Address-book matches for what is typed in the drawer's Assignee box.
    in-out property <[ActionMenuEntry]> assignee-suggestions;
    // The other people on the open task: id = address, title = shown name.
    in-out property <[ActionMenuEntry]> co-assignees;
    // The name of the fixed Assignee picker entries ("me" and "none").
    pure callback calendar-title(string) -> string;
    calendar-title(id) => { return @tr("Local calendar"); }
    pure callback assignee-title(string) -> string;
    assignee-title(id) => { return id == "me" ? @tr("Me") : id == "find" ? @tr("Find or add people…") : @tr("Unassigned"); }
    // The drawer header's menu: the card menu's moves, then these entries.
    in-out property <[ActionMenuEntry]> detail-menu;
    pure callback detail-title(string) -> string;
    detail-title(id) => { return id == "priority" ? @tr("High priority") : @tr("Delete task"); }
    // The text of a filter chip or "Add filter" entry: kind is label, context,
    // linked or assignee; name is what follows the English "Kind: ".
    pure callback chip-title(string, string) -> string;
    chip-title(kind, name) => {
        return kind == "label" ? @tr("Label: {}", name)
        : kind == "context" ? @tr("Context: {}", name)
        : kind == "assignee" ? (name == "Me" ? @tr("Assignee: Me") : @tr("Assignee: {}", name))
        : name == "Mail" ? @tr("Linked to: Mail")
        : name == "Event" ? @tr("Linked to: Event")
        : @tr("Linked to: Task");
    }
    // The activity log shows the engine's fixed English entries in the UI language.
    pure callback activity-title(string) -> string;
    activity-title(text) => {
        return text == "Task created" ? @tr("Task created")
        : text == "Email sent" ? @tr("Email sent")
        : text == "Reopened" ? @tr("Reopened")
        : text == "Changed labels" ? @tr("Changed labels")
        : text == "Linked an item" ? @tr("Linked an item")
        : text == "Removed a link" ? @tr("Removed a link")
        : text == "Moved to another project" ? @tr("Moved to another project")
        : text == "Moved to Waiting for: email sent" ? @tr("Moved to Waiting for: email sent")
        : text == "Moved back to Next actions: a reply arrived" ? @tr("Moved back to Next actions: a reply arrived")
        : text;
    }
    in-out property <[TaskChipRow]> filter-chips;
    // Today's date for the right end of the chip row, e.g. "Thu, Oct 29".
    in-out property <string> today-label;
    /// ISO week of today, "W44".
    in-out property <string> week-label;
    // The Timeline (Gantt) view of a project.
    in-out property <bool> timeline-mode: false;
    in-out property <[TimelineDayRow]> timeline-days;
    in-out property <[TimelineBarRow]> timeline-bars;
    in-out property <[TimelineEdgeRow]> timeline-edges;
    in-out property <[TimelineEventRow]> timeline-events;
    // Events that found no free row in the lane.
    in-out property <int> timeline-events-hidden: 0;
    in-out property <int> timeline-today: -1;
    // First day of the chart window (a day number) and whether it was moved from
    // its home position; scrolling to an edge asks the controller to move it.
    in-out property <int> timeline-origin: 0;
    in-out property <bool> timeline-shifted: false;
    in-out property <int> timeline-undated: 0;
    // Local time for the "Today" label, and tasks past the row cap.
    in-out property <string> timeline-now;
    in-out property <int> timeline-bars-hidden: 0;
    // The card open at the start (the chart owns it afterwards); for tests.
    in-out property <int> timeline-selected: -1;
    in-out property <int> timeline-selected-index: -1;
    // Every list can be shown as a timeline, not only projects.
    in-out property <bool> timeline-available: false;
    // A dragged bar can be put back.
    in-out property <bool> timeline-can-undo: false;
    // The chart's own state outlives the view: zoom, lane and arrows, and where
    // it was scrolled to (left-most day as a day number, rows, and the list it
    // belongs to).
    in-out property <string> timeline-zoom: "week";
    in-out property <bool> timeline-show-events: true;
    in-out property <bool> timeline-show-dependencies: true;
    in-out property <float> timeline-scroll-day: 0;
    in-out property <length> timeline-scroll-y: 0px;
    in-out property <string> timeline-scroll-key: "";
    // Calendars the events lane can draw, ticked when shown.
    in-out property <[ActionMenuEntry]> timeline-calendar-menu;
    callback open-calendar-event(int, string, bool);
    in-out property <string> timeline-title;
    // Display menu: completed tasks on the board, and compact cards.
    in-out property <bool> show-completed: true;
    in-out property <bool> compact-cards: false;
    in-out property <[ActionMenuEntry]> filter-menu;
    in-out property <[ActionMenuEntry]> context-menu;
    in-out property <[TaskLabelRow]> label-rows;
    in-out property <string> label-query;
    // How many label rows the search leaves in the list.
    in-out property <int> label-shown: 0;
    pure callback chip-flow([TaskLabelRow], length, length) -> [ChipPos];
    // "focus:<name>", "project:<id>" or "context:<id>".
    in-out property <string> selection: "focus:inbox";
    // Project or context name; empty for the focus lists (named in Slint).
    in-out property <string> title;
    in-out property <int> task-count;
    in-out property <string> query;
    in-out property <string> status;
    in-out property <bool> loading: false;
    // Column id with the inline "add task" row open; -2 = none.
    in-out property <int> adding-column: -2;
    // "" | "project" | "context": sidebar row being created.
    in-out property <string> creating: "";
    in-out property <bool> sidebar-collapsed: false;
    in-out property <bool> navigation-open: false;
    callback command(string, string, string);
    // Keyboard cursor of the board: the focused card's id (-1 = none) and
    // whether the board has keyboard focus (the cursor is drawn only then).
    in-out property <int> cursor: -1;
    in-out property <bool> board-focused: false;
    // Drag payloads are opaque in Slint; the host builds and reads them.
    pure callback to-transfer(string) -> data-transfer;
    pure callback text-of(data-transfer) -> string;
}

global TasksText {
    // Twenty colours for a column or a project, bright row then deeper row.
    out property <[{hex: string, c: color}]> palette: [
        { hex: "#ef4444", c: #ef4444 },
        { hex: "#f97316", c: #f97316 },
        { hex: "#f59e0b", c: #f59e0b },
        { hex: "#eab308", c: #eab308 },
        { hex: "#84cc16", c: #84cc16 },
        { hex: "#22c55e", c: #22c55e },
        { hex: "#14b8a6", c: #14b8a6 },
        { hex: "#06b6d4", c: #06b6d4 },
        { hex: "#3b82f6", c: #3b82f6 },
        { hex: "#8b5cf6", c: #8b5cf6 },
        { hex: "#b91c1c", c: #b91c1c },
        { hex: "#c2410c", c: #c2410c },
        { hex: "#b45309", c: #b45309 },
        { hex: "#a16207", c: #a16207 },
        { hex: "#4d7c0f", c: #4d7c0f },
        { hex: "#15803d", c: #15803d },
        { hex: "#0f766e", c: #0f766e },
        { hex: "#0e7490", c: #0e7490 },
        { hex: "#1d4ed8", c: #1d4ed8 },
        { hex: "#6d28d9", c: #6d28d9 }
    ];
    // Tokens come from the column menu and the default columns.
    pure public function column-icon(token: string) -> image {
        return token == "inbox" ? @image-url("../icons/lucide/outline/mail-open.svg")
        : token == "bolt" ? @image-url("../icons/lucide/outline/star.svg")
        : token == "hourglass" ? @image-url("../icons/lucide/outline/history.svg")
        : token == "calendar" ? @image-url("../icons/lucide/outline/calendar.svg")
        : token == "check" ? @image-url("../icons/lucide/outline/check-circle.svg")
        : token == "moon" ? @image-url("../icons/lucide/outline/archive.svg")
        : token == "mail" ? @image-url("../icons/lucide/outline/mail.svg")
        : token == "alert" ? @image-url("../icons/lucide/outline/alert.svg")
        : token == "people" ? @image-url("../icons/lucide/outline/people.svg")
        : @image-url("../icons/lucide/outline/tasks.svg");
    }
    // One icon per Focus row, as in the design.
    pure public function focus-icon(key: string) -> image {
        return key == "focus:inbox" ? column-icon("inbox")
        : key == "focus:today" ? column-icon("bolt")
        : key == "focus:upcoming" ? column-icon("calendar")
        : key == "focus:waiting" ? column-icon("hourglass")
        : key == "focus:email" ? column-icon("mail")
        : column-icon("moon");
    }
    pure public function focus-label(key: string) -> string {
        return key == "focus:inbox" ? @tr("Inbox")
        : key == "focus:today" ? @tr("Today")
        : key == "focus:upcoming" ? @tr("Upcoming")
        : key == "focus:waiting" ? @tr("Waiting for")
        : key == "focus:email" ? @tr("From email")
        : @tr("Someday / Maybe");
}
}

// IconButton has no default icon colour, which renders black on dark themes.
component TasksIconButton inherits ToolbarIconButton {
    icon-color: AppTheme.secondary;
    hover-background: AppTheme.muted-control-bg;
}

component TasksNavItem inherits SidebarItem {
    sidebar-background: AppTheme.sidebar-bg;
    selection-background: AppTheme.accent-soft;
    accent-color: AppTheme.accent;
    body-color: AppTheme.body;
    muted-color: AppTheme.muted;
    icon-color: root.selected ? AppTheme.accent : AppTheme.secondary;
    row-height: 32px;
}

// Diagonal stripes over a bar: the span still waiting for a reply.
component TimelineHatch inherits Rectangle {
    in property <color> line-colour: #ffffff;
    clip: true;
    for k in Math.min(120, Math.ceil((self.width + self.height) / 7px)) : Path {
        x: k * 7px - parent.height;
        y: 0px;
        width: parent.height;
        height: parent.height;
        viewbox-width: 1;
        viewbox-height: 1;
        commands: "M 0 1 L 1 0";
        stroke: root.line-colour;
        stroke-width: 1px;
    }
}

component TasksTimeline inherits Rectangle {
    // The task whose summary card is open, and where it sits in the rows.
    in-out property <int> selected-id: TasksUi.timeline-selected;
    in-out property <int> selected-index: TasksUi.timeline-selected-index;
    function select(index: int, id: int) {
        root.selected-index = index;
        root.selected-id = id;
        nudge.focus();
        root.reveal(TasksUi.timeline-bars[index].first-day, TasksUi.timeline-bars[index].last-day);
    }
    // Arrow keys move the selected bar a day; Shift moves its due edge, Ctrl
    // its start edge.
    nudge := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if root.selected-id < 0 { return reject; }
            if event.text == Key.Escape {
                root.selected-id = -1;
                return accept;
            }
            if event.text == Key.LeftArrow || event.text == Key.RightArrow {
                TasksUi.command("timeline-drag", "" + root.selected-id,
                    (event.modifiers.shift ? "due:" : event.modifiers.control ? "start:" : "move:")
                    + (event.text == Key.RightArrow ? "1" : "-1"));
                return accept;
            }
            reject
        }
    }
    // "day" | "week" | "month"
    in-out property <string> zoom <=> TasksUi.timeline-zoom;
    // Finish-to-start arrows between bars.
    in-out property <bool> show-dependencies <=> TasksUi.timeline-show-dependencies;
    // Read-only calendar events lane above the tasks.
    in-out property <bool> show-events <=> TasksUi.timeline-show-events;
    private property <length> lane-height: root.show-events ? 80px : 0px;
    private property <length> day-width: root.zoom == "day" ? 44px : root.zoom == "week" ? 22px : 9px;
    private property <length> row-height: 32px;
    private property <length> toolbar-height: 40px;
    private property <length> header-height: 44px;
    private property <length> legend-height: 28px;
    // The task grid on the left is dropped when the window is narrow.
    private property <length> left-width: root.width < 720px ? 0px : 416px;
    private property <length> chart-width: TasksUi.timeline-days.length * root.day-width;
    private property <length> rows-height: root.lane-height + TasksUi.timeline-bars.length * root.row-height;
    // Only the rows and days in (or just beside) the view are instantiated;
    // the elements are recycled as the chart scrolls.
    private property <int> first-row: max(0, Math.floor((-chart.content-y - root.lane-height) / root.row-height) - 4);
    private property <int> shown-rows: max(0, min(Math.ceil(chart.visible-height / root.row-height) + 10, TasksUi.timeline-bars.length - root.first-row));
    // The day in the middle of the chart, whose month the toolbar shows.
    private property <int> middle-day: max(0, min(TasksUi.timeline-days.length - 1,
        Math.floor((-chart.content-x + chart.visible-width / 2) / root.day-width)));
    private property <int> first-day: max(0, Math.floor(-chart.content-x / root.day-width) - 8);
    private property <int> shown-days: max(0, min(Math.ceil(chart.visible-width / root.day-width) + 18, TasksUi.timeline-days.length - root.first-day));
    private property <int> today-index: TasksUi.timeline-today;
    private property <int> origin: TasksUi.timeline-origin;
    private property <int> seen-origin: -1;
    private property <bool> want-today: false;
    private property <bool> shifting: false;

    // The left-most day, kept when the zoom changes.
    private property <float> pending-day: 0;
    function left-day() -> float {
        return root.origin + (-chart.content-x / root.day-width);
    }
    // Where the chart is scrolled to outlives the view, per list.
    function remember() {
        TasksUi.timeline-scroll-day = root.left-day();
        TasksUi.timeline-scroll-y = chart.content-y;
        TasksUi.timeline-scroll-key = TasksUi.selection;
    }
    function keep-y() {
        chart.content-y = max(min(0px, TasksUi.timeline-scroll-y), min(0px, chart.visible-height - root.rows-height));
    }
    function scroll-to-day(day: float) {
        chart.content-x = min(0px, max(chart.visible-width - root.chart-width,
            -(day - root.origin) * root.day-width));
    }
    function scroll-to-today() {
        chart.content-x = min(0px, max(chart.visible-width - root.chart-width,
            root.day-width * 3 - root.today-index * root.day-width));
        root.remember();
    }
    function scroll-by(days: int) {
        chart.content-x = min(0px, max(chart.visible-width - root.chart-width,
            chart.content-x - days * root.day-width));
        root.remember();
    }
    // A task picked in the grid whose bar is out of sight brings it into view.
    function reveal(first: int, last: int) {
        if (last + 1) * root.day-width <= -chart.content-x + root.day-width
            || first * root.day-width >= -chart.content-x + chart.visible-width - root.day-width {
            chart.content-x = min(0px, max(chart.visible-width - root.chart-width,
                root.day-width * 3 - first * root.day-width));
            root.remember();
        }
    }
    // Near an edge of the window, ask for the next 26 weeks. The window has a
    // fixed size, so scrolling far costs no more memory.
    function edge-check() {
        if root.shifting || root.chart-width < chart.visible-width + 84 * root.day-width {
            return;
        }
        if chart.content-x > -21 * root.day-width {
            root.shifting = true;
            TasksUi.command("timeline-shift", "-26", "");
        } else if chart.content-x < chart.visible-width - root.chart-width + 21 * root.day-width {
            root.shifting = true;
            TasksUi.command("timeline-shift", "26", "");
        }
    }
    init => {
        root.seen-origin = root.origin;
        if TasksUi.timeline-scroll-key == TasksUi.selection
            && TasksUi.timeline-scroll-day >= root.origin
            && TasksUi.timeline-scroll-day < root.origin + TasksUi.timeline-days.length {
            root.scroll-to-day(TasksUi.timeline-scroll-day);
            root.keep-y();
        } else {
            root.scroll-to-today();
        }
    }
    changed day-width => {
        if root.pending-day > 0 {
            root.scroll-to-day(root.pending-day);
            root.pending-day = 0;
            root.remember();
        } else {
            root.scroll-to-today();
        }
    }
    // Fewer or more rows: the clamp must not lose the place.
    changed rows-height => {
        if TasksUi.timeline-scroll-key == TasksUi.selection { root.keep-y(); }
    }
    changed today-index => {
        if !root.shifting && !root.want-today && !TasksUi.timeline-shifted { root.scroll-to-today(); }
    }
    // The window moved: keep the same date under the same pixel.
    changed origin => {
        if root.seen-origin < 0 || root.want-today {
            root.scroll-to-today();
        } else {
            chart.content-x = min(0px, max(chart.visible-width - root.chart-width,
                chart.content-x - (root.origin - root.seen-origin) * root.day-width));
        }
        root.want-today = false;
        root.shifting = false;
        root.seen-origin = root.origin;
    }

    // Toolbar: month and year, tasks without dates, zoom, Today and paging.
    HorizontalLayout {
        z: 30;
        x: 0px;
        y: 0px;
        width: parent.width;
        height: root.toolbar-height;
        spacing: 6px;
        padding-bottom: 6px;
        Text {
            text: TasksUi.timeline-days.length > 0 ? TasksUi.timeline-days[root.middle-day].month : TasksUi.timeline-title;
            color: AppTheme.heading;
            font-size: TypeScale.body;
            font-weight: 700;
            vertical-alignment: center;
        }
        Rectangle {
            width: weekbadge.preferred-width + 12px;
            height: 20px;
            y: 2px;
            border-radius: 10px;
            background: AppTheme.sidebar-bg;
            weekbadge := Text {
                x: 6px;
                text: TasksUi.week-label;
                color: AppTheme.secondary;
                font-size: TypeScale.caption;
                vertical-alignment: center;
            }
        }
        Text {
            text: TasksUi.timeline-undated > 0 ? @tr("{} without dates", TasksUi.timeline-undated)
                : TasksUi.timeline-bars-hidden > 0 ? @tr("{} more tasks not shown", TasksUi.timeline-bars-hidden) : "";
            color: AppTheme.secondary;
            font-size: TypeScale.caption;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle { horizontal-stretch: 1; }
        for choice in [
            { id: "day", text: @tr("Day") },
            { id: "week", text: @tr("Week") },
            { id: "month", text: @tr("Month") },
        ] : Button {
            height: 28px;
            width: max(60px, self.content-width + 20px);
            text: choice.text;
            primary: root.zoom == choice.id;
            clicked => {
                root.pending-day = root.left-day();
                root.zoom = choice.id;
            }
        }
        Button {
            height: 28px;
            width: max(60px, self.content-width + 20px);
            text: @tr("Calendar events");
            primary: root.show-events;
            clicked => { root.show-events = !root.show-events; }
        }
        if TasksUi.timeline-can-undo : ToolbarIconButton {
            width: 28px;
            height: 28px;
            icon: @image-url("../icons/lucide/outline/undo.svg");
            tooltip-text: @tr("Undo");
            clicked => { TasksUi.command("timeline-undo", "", ""); }
        }
        if TasksUi.timeline-calendar-menu.length > 1 : ActionMenu {
            width: 28px;
            height: 28px;
            icon: @image-url("../icons/lucide/outline/calendar.svg");
            entries: TasksUi.timeline-calendar-menu;
            menu-width: 260px;
            align-right: true;
            tooltip-text: @tr("Calendars shown");
            activated(id) => { TasksUi.command("timeline-calendar", id, ""); }
        }
        Button {
            height: 28px;
            width: max(60px, self.content-width + 20px);
            text: @tr("Dependencies");
            primary: root.show-dependencies;
            clicked => { root.show-dependencies = !root.show-dependencies; }
        }
        Button {
            height: 28px;
            width: max(60px, self.content-width + 20px);
            text: @tr("Today");
            clicked => {
                if TasksUi.timeline-shifted {
                    root.want-today = true;
                    TasksUi.command("timeline-shift", "reset", "");
                } else {
                    root.scroll-to-today();
                }
            }
        }
        ToolbarIconButton {
            width: 28px;
            height: 28px;
            icon: @image-url("../icons/lucide/outline/chevron-left.svg");
            tooltip-text: @tr("Previous week");
            clicked => { root.scroll-by(-7); }
        }
        ToolbarIconButton {
            width: 28px;
            height: 28px;
            icon: @image-url("../icons/lucide/outline/chevron-right.svg");
            tooltip-text: @tr("Next week");
            clicked => { root.scroll-by(7); }
        }
    }

    // Left grid: TASK, START, DUE.
    if root.left-width > 0px : Rectangle {
        x: 0px;
        y: root.toolbar-height;
        width: root.left-width;
        height: parent.height - root.toolbar-height - root.legend-height;
        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: root.header-height;
            background: AppTheme.sidebar-bg;
            Text { x: 8px; width: parent.width - 270px; height: parent.height; text: @tr("TASK"); color: AppTheme.secondary; font-size: TypeScale.caption; font-weight: 700; vertical-alignment: center; }
            Text { x: parent.width - 262px; width: 88px; height: parent.height; text: @tr("START"); color: AppTheme.secondary; font-size: TypeScale.caption; font-weight: 700; vertical-alignment: center; }
            Text { x: parent.width - 174px; width: 88px; height: parent.height; text: @tr("DUE"); color: AppTheme.secondary; font-size: TypeScale.caption; font-weight: 700; vertical-alignment: center; }
            Text { x: parent.width - 82px; width: 76px; height: parent.height; text: @tr("LINKS"); color: AppTheme.secondary; font-size: TypeScale.caption; font-weight: 700; vertical-alignment: center; }
        }
        Rectangle {
            x: 0px;
            y: root.header-height - 1px;
            width: parent.width;
            height: 1px;
            background: AppTheme.border;
        }
        left-rows := ScrollView {
            y: root.header-height;
            width: parent.width;
            height: parent.height - root.header-height;
            content-width: self.visible-width;
            content-height: root.rows-height;
            vertical-scrollbar-policy: always-off;
            horizontal-scrollbar-policy: always-off;
            content-y <=> chart.content-y;
            if root.show-events : Rectangle {
                x: 0px;
                y: root.lane-height - 1px;
                width: left-rows.visible-width;
                height: 1px;
                background: AppTheme.border;
            }
            if root.show-events : Text {
                x: 8px;
                y: 0px;
                width: parent.width - 16px;
                height: root.lane-height;
                text: TasksUi.timeline-events-hidden > 0 ? @tr("CALENDAR EVENTS (+{} more)", TasksUi.timeline-events-hidden) : @tr("CALENDAR EVENTS");
                color: AppTheme.secondary;
                font-size: TypeScale.caption;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
            }
            for k in root.shown-rows : lrow := Rectangle {
                property <int> i: root.first-row + k;
                property <TimelineBarRow> bar: TasksUi.timeline-bars[self.i];
                x: 0px;
                y: root.lane-height + i * root.row-height;
                width: left-rows.visible-width;
                height: root.row-height;
                if lrow.bar.id == root.selected-id && !lrow.bar.group : Rectangle {
                    background: AppTheme.accent.with-alpha(0.1);
                }
                if lrow.bar.group : Image {
                    x: 6px;
                    y: (parent.height - 12px) / 2;
                    width: 12px;
                    height: 12px;
                    source: lrow.bar.collapsed ? @image-url("../icons/lucide/outline/chevron-right.svg") : @image-url("../icons/lucide/outline/chevron-down.svg");
                    colorize: AppTheme.secondary;
                    accessible-role: none;
                }
                if lrow.bar.group : Rectangle {
                    x: 22px;
                    y: (parent.height - 10px) / 2;
                    width: 10px;
                    height: 10px;
                    border-radius: 3px;
                    background: lrow.bar.coloured ? lrow.bar.group-colour : AppTheme.accent;
                }
                if !lrow.bar.group : Rectangle {
                    x: 8px;
                    y: (parent.height - 10px) / 2;
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    border-width: 1.5px;
                    border-color: lrow.bar.done ? AppTheme.muted : lrow.bar.overdue ? AppTheme.destructive : lrow.bar.coloured ? lrow.bar.group-colour : AppTheme.accent;
                    background: lrow.bar.done ? AppTheme.muted : transparent;
                }
                Text { x: lrow.bar.group ? 38px : 24px; width: parent.width - (lrow.bar.group ? 308px : 294px); height: parent.height; text: lrow.bar.done && !lrow.bar.group && lrow.bar.struck-title != "" ? lrow.bar.struck-title : lrow.bar.title; color: lrow.bar.done && !lrow.bar.group ? AppTheme.muted : AppTheme.heading; font-size: TypeScale.secondary; font-weight: lrow.bar.group ? 700 : 400; vertical-alignment: center; overflow: elide; }
                Text { x: parent.width - 262px; width: 88px; height: parent.height; text: lrow.bar.start-text; color: AppTheme.secondary; font-size: TypeScale.caption; vertical-alignment: center; }
                Text { x: parent.width - 174px; width: 88px; height: parent.height; text: lrow.bar.due-text; color: lrow.bar.overdue ? AppTheme.destructive : AppTheme.secondary; font-size: TypeScale.caption; vertical-alignment: center; }
                for glyph[k] in [
                    { shown: lrow.bar.has-mail, icon: @image-url("../icons/lucide/outline/mail.svg") },
                    { shown: lrow.bar.has-sent, icon: @image-url("../icons/lucide/outline/paper-airplane.svg") },
                    { shown: lrow.bar.has-event, icon: @image-url("../icons/lucide/outline/calendar.svg") },
                ] : Image {
                    x: parent.width - 82px + k * 20px;
                    y: (parent.height - self.height) / 2;
                    width: 14px;
                    height: 14px;
                    source: glyph.icon;
                    colorize: AppTheme.accent;
                    visible: glyph.shown;
                }
                TouchArea {
                    accessible-role: button;
                    accessible-label: lrow.bar.title;
                    mouse-cursor: pointer;
                    clicked => {
                        if lrow.bar.group {
                            TasksUi.command("timeline-collapse", "" + lrow.bar.column-id, "");
                        } else {
                            root.select(lrow.i, lrow.bar.id);
                        }
                    }
                }
            }
        }
    }

    // Divider between the task grid and the chart.
    if root.left-width > 0px : Rectangle {
        x: root.left-width - 1px;
        y: root.toolbar-height;
        width: 1px;
        height: parent.height - root.toolbar-height - root.legend-height;
        background: AppTheme.border;
    }

    // Chart: header on top (week and day), then the bars.
    Rectangle {
        x: root.left-width;
        y: root.toolbar-height;
        width: parent.width - root.left-width;
        height: parent.height - root.toolbar-height - root.legend-height;
        clip: true;
        header := ScrollView {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: root.header-height;
            content-width: root.chart-width;
            content-height: root.header-height;
            vertical-scrollbar-policy: always-off;
            horizontal-scrollbar-policy: always-off;
            content-x <=> chart.content-x;
            // The ISO week sits over the seven days it covers, not in one cell.
            for k in root.shown-days : hweek := Rectangle {
                property <int> i: root.first-day + k;
                property <TimelineDayRow> day: TasksUi.timeline-days[self.i];
                x: i * root.day-width + 2px;
                y: 2px;
                width: root.day-width * 7 - 4px;
                height: 18px;
                if hweek.day.week != "" : Text {
                    width: parent.width;
                    height: parent.height;
                    text: hweek.day.week;
                    color: AppTheme.secondary;
                    font-size: TypeScale.micro;
                    font-weight: 700;
                    overflow: elide;
                }
            }
            for k in root.shown-days : hday := Rectangle {
                property <int> i: root.first-day + k;
                property <TimelineDayRow> day: TasksUi.timeline-days[self.i];
                x: i * root.day-width;
                y: 0px;
                width: root.day-width;
                height: root.header-height;
                background: hday.day.weekend ? AppTheme.sidebar-bg : transparent;
                if hday.day.today && root.day-width >= 20px : Rectangle {
                    x: (parent.width - 24px) / 2;
                    y: 20px;
                    width: 24px;
                    height: 24px;
                    border-radius: 12px;
                    background: AppTheme.accent-soft;
                }
                if root.day-width >= 20px : Text {
                    y: 20px;
                    width: parent.width;
                    height: 24px;
                    text: hday.day.label;
                    color: hday.day.today ? AppTheme.accent : AppTheme.body;
                    font-size: TypeScale.caption;
                    font-weight: hday.day.today ? 800 : 400;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle {
            x: 0px;
            y: root.header-height - 1px;
            width: parent.width;
            height: 1px;
            background: AppTheme.border;
        }
        chart := ScrollView {
            changed content-x => { root.edge-check(); }
            scrolled => { root.remember(); }
            y: root.header-height;
            width: parent.width;
            height: parent.height - root.header-height;
            content-width: root.chart-width;
            content-height: max(root.rows-height, self.visible-height);
            for k in root.shown-days : cday := Rectangle {
                property <int> i: root.first-day + k;
                property <TimelineDayRow> day: TasksUi.timeline-days[self.i];
                x: i * root.day-width;
                y: 0px;
                width: root.day-width;
                height: max(root.rows-height, chart.visible-height);
                background: cday.day.weekend ? AppTheme.sidebar-bg : transparent;
                if cday.day.week != "" : Rectangle { x: 0px; y: 0px; width: 1px; background: AppTheme.border; }
            }
            if TasksUi.timeline-today >= 0 : Rectangle {
                x: TasksUi.timeline-today * root.day-width + root.day-width / 2 - 1px;
                y: 0px;
                width: 2px;
                height: max(root.rows-height, chart.visible-height);
                background: AppTheme.accent;
                Rectangle {
                    x: -3px;
                    y: 0px;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: AppTheme.accent;
                }
                Rectangle {
                    x: 8px;
                    y: 0px;
                    width: today-text.preferred-width + 10px;
                    height: 24px;
                    border-radius: 3px;
                    background: AppTheme.accent;
                    today-text := Text {
                        x: 5px;
                        y: 0px;
                        width: self.preferred-width;
                        height: parent.height;
                        wrap: no-wrap;
                        text: TasksUi.timeline-now == "" ? @tr("Today") : @tr("Today") + " " + TasksUi.timeline-now;
                        color: #ffffff;
                        font-size: TypeScale.caption;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }
            for k in root.shown-rows : cell := Rectangle {
                property <int> i: root.first-row + k;
                property <TimelineBarRow> bar: TasksUi.timeline-bars[self.i];
                // The cell stays put while a bar is dragged, so the pointer keeps
                // one frame of reference; only the drawn bar follows it.
                x: cell.bar.first-day * root.day-width;
                y: root.lane-height + i * root.row-height;
                width: (cell.bar.last-day - cell.bar.first-day + 1) * root.day-width;
                height: root.row-height;
                property <string> drag-kind: "";
                property <int> drag-days: 0;
                property <length> shift-x: (self.drag-kind == "move" || self.drag-kind == "start") ? self.drag-days * root.day-width : 0px;
                property <length> grow: self.drag-kind == "start" ? -self.drag-days * root.day-width : self.drag-kind == "due" ? self.drag-days * root.day-width : 0px;
                if cell.bar.id == root.selected-id && !cell.bar.group : Rectangle {
                    x: -cell.x;
                    width: root.chart-width;
                    background: AppTheme.accent.with-alpha(0.08);
                }
                bar-body := Rectangle {
                    x: cell.shift-x;
                    width: max(root.day-width, cell.width + cell.grow);
                    height: parent.height;
                    if cell.bar.group : Rectangle {
                        x: 1px;
                        y: (parent.height - 6px) / 2;
                        width: parent.width - 2px;
                        height: 6px;
                        border-radius: 3px;
                        background: (cell.bar.coloured ? cell.bar.group-colour : AppTheme.accent).with-alpha(0.3);
                        Rectangle {
                            width: parent.width * cell.bar.progress / 100;
                            border-radius: 3px;
                            background: cell.bar.coloured ? cell.bar.group-colour : AppTheme.accent;
                        }
                    }
                    if !cell.bar.milestone && !cell.bar.group : Rectangle {
                        x: 1px;
                        y: 7px;
                        width: parent.width - 2px;
                        height: parent.height - 14px;
                        border-radius: 4px;
                        clip: true;
                        background: (cell.bar.done ? AppTheme.muted : cell.bar.overdue ? AppTheme.destructive : cell.bar.coloured ? cell.bar.group-colour : AppTheme.accent).with-alpha(cell.bar.progress > 0 && !cell.bar.done ? 0.35 : 1);
                        opacity: cell.bar.done ? 0.6 : 1;
                        if cell.bar.progress > 0 && !cell.bar.done : Rectangle {
                            width: parent.width * cell.bar.progress / 100;
                            border-radius: 4px;
                            background: cell.bar.overdue ? AppTheme.destructive : cell.bar.coloured ? cell.bar.group-colour : AppTheme.accent;
                        }
                        if cell.bar.waiting-from >= 0 && !cell.bar.done : TimelineHatch {
                            x: (cell.bar.waiting-from - cell.bar.first-day) * root.day-width;
                            width: max(0px, parent.width - self.x);
                            height: parent.height;
                            line-colour: #ffffffaa;
                        }
                    }
                    if !cell.bar.group && cell.bar.overdue && cell.bar.late-days > 0 : Text {
                        x: cell.bar.milestone ? (parent.width + 16px) / 2 + 6px : parent.width + 6px;
                        width: 160px;
                        height: parent.height;
                        text: @tr("{} days late", cell.bar.late-days);
                        color: AppTheme.destructive;
                        font-size: TypeScale.caption;
                        vertical-alignment: center;
                    }
                    if !cell.bar.group && !cell.bar.done && !cell.bar.overdue && cell.bar.no-reply-days >= 0 : Text {
                        x: cell.bar.milestone ? (parent.width + 16px) / 2 + 6px : parent.width + 6px;
                        width: 160px;
                        height: parent.height;
                        text: @tr("No reply · {}d", cell.bar.no-reply-days);
                        color: AppTheme.destructive;
                        font-size: TypeScale.caption;
                        vertical-alignment: center;
                    }
                    if !cell.bar.milestone && !cell.bar.group && !cell.bar.overdue && cell.bar.no-reply-days < 0 && cell.bar.progress > 0 : Text {
                        x: parent.width + 6px;
                        width: 40px;
                        height: parent.height;
                        text: cell.bar.done ? "100%" : cell.bar.progress + "%";
                        color: AppTheme.secondary;
                        font-size: TypeScale.caption;
                        vertical-alignment: center;
                    }
                    if cell.bar.milestone : Path {
                        x: (parent.width - 16px) / 2;
                        y: 8px;
                        width: 16px;
                        height: 16px;
                        viewbox-width: 16;
                        viewbox-height: 16;
                        commands: "M 8 0 L 16 8 L 8 16 L 0 8 Z";
                        fill: cell.bar.done ? AppTheme.muted : cell.bar.overdue ? AppTheme.destructive : cell.bar.coloured ? cell.bar.group-colour : AppTheme.accent;
                    }
                }
                // Mail and event pins, on the day each happened.
                if !cell.bar.group && root.day-width >= 20px : Rectangle {
                    for pin in cell.bar.pins : Rectangle {
                        x: (pin.day - cell.bar.first-day) * root.day-width + root.day-width / 2 - 9px;
                        y: (cell.height - 18px) / 2;
                        width: 18px;
                        height: 18px;
                        border-radius: 9px;
                        border-width: 1.5px;
                        border-color: pin.kind == "event" ? #8b5cf6 : AppTheme.accent;
                        background: AppTheme.surface;
                        Image {
                            x: 3px;
                            y: 3px;
                            width: 12px;
                            height: 12px;
                            source: pin.kind == "event" ? @image-url("../icons/lucide/outline/calendar.svg")
                                : pin.kind == "sent" ? @image-url("../icons/lucide/outline/paper-airplane.svg")
                                : @image-url("../icons/lucide/outline/mail.svg");
                            colorize: pin.kind == "event" ? #8b5cf6 : AppTheme.accent;
                            accessible-role: none;
                        }
                    }
                }
                // Drag the bar to move both dates; a click opens its card.
                body-touch := TouchArea {
                    accessible-role: button;
                    accessible-label: cell.bar.title;
                    enabled: !cell.bar.group;
                    mouse-cursor: pointer;
                    pointer-event(event) => {
                        if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                            if cell.drag-kind == "move" && cell.drag-days != 0 {
                                TasksUi.command("timeline-drag", "" + cell.bar.id, "move:" + cell.drag-days);
                            } else if cell.drag-kind == "" {
                                root.select(cell.i, cell.bar.id);
                            }
                            cell.drag-kind = "";
                            cell.drag-days = 0;
                        }
                    }
                    moved => {
                        if self.pressed && (cell.drag-kind == "move" || abs(self.mouse-x - self.pressed-x) > 4px) {
                            cell.drag-kind = "move";
                            cell.drag-days = Math.round((self.mouse-x - self.pressed-x) / root.day-width);
                        }
                    }
                }
                // Drag an edge to change the start or the due date.
                if !cell.bar.group && !cell.bar.milestone : Rectangle {
                    for edge[k] in ["start", "due"] : TouchArea {
                        x: k == 0 ? 0px : cell.width - 7px;
                        width: 7px;
                        height: cell.height;
                        mouse-cursor: ew-resize;
                        accessible-role: none;
                        pointer-event(event) => {
                            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                                if cell.drag-kind == edge && cell.drag-days != 0 {
                                    TasksUi.command("timeline-drag", "" + cell.bar.id, edge + ":" + cell.drag-days);
                                }
                                cell.drag-kind = "";
                                cell.drag-days = 0;
                            }
                        }
                        moved => {
                            if self.pressed {
                                cell.drag-kind = edge;
                                cell.drag-days = Math.round((self.mouse-x - self.pressed-x) / root.day-width);
                            }
                        }
                    }
                }
            }
            if root.show-events : Rectangle {
                y: root.lane-height - 1px;
                width: root.chart-width;
                height: 1px;
                background: AppTheme.border;
            }
            for event in TasksUi.timeline-events : Rectangle {
                visible: root.show-events;
                x: event.first-day * root.day-width + 1px;
                y: 8px + event.lane * 24px;
                width: (event.last-day - event.first-day + 1) * root.day-width - 2px;
                height: 22px;
                border-radius: 5px;
                border-width: 1px;
                border-color: event.coloured ? event.colour : AppTheme.accent;
                background: (event.coloured ? event.colour : AppTheme.accent).with-alpha(0.15);
                clip: true;
                Text {
                    x: 6px;
                    width: parent.width - 8px;
                    height: parent.height;
                    text: event.label;
                    color: AppTheme.heading;
                    font-size: TypeScale.micro;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
                TouchArea {
                    accessible-role: button;
                    accessible-label: event.label;
                    mouse-cursor: pointer;
                    clicked => { TasksUi.open-calendar-event(event.id, event.date, event.local); }
                }
            }
            // Each arrow is drawn in its own bounding box, and only when one of its
            // rows is near the view.
            for edge in TasksUi.timeline-edges : Path {
                private property <length> x1: (TasksUi.timeline-bars[edge.from-bar].last-day + 1) * root.day-width;
                private property <length> y1: root.lane-height + edge.from-bar * root.row-height + root.row-height / 2;
                private property <length> x2: TasksUi.timeline-bars[edge.to-bar].first-day * root.day-width;
                private property <length> y2: root.lane-height + edge.to-bar * root.row-height + root.row-height / 2;
                private property <length> mid: self.x1 + 8px;
                // The dependent starts before its prerequisite ends: the arrow
                // is red and runs along the gap between the rows, not through bars.
                private property <bool> conflict: TasksUi.timeline-bars[edge.to-bar].first-day <= TasksUi.timeline-bars[edge.from-bar].last-day;
                private property <length> gap-y: self.y1 < self.y2 ? self.y1 + root.row-height / 2 : self.y1 - root.row-height / 2;
                private property <length> left: min(self.x1, self.x2 - 12px) - 8px;
                private property <length> top: min(self.y1, self.y2) - 6px;
                visible: root.show-dependencies
                    && max(edge.from-bar, edge.to-bar) >= root.first-row - 2
                    && min(edge.from-bar, edge.to-bar) <= root.first-row + root.shown-rows + 2;
                x: self.left;
                y: self.top;
                width: max(self.mid, self.x2) + 4px - self.left;
                height: max(self.y1, self.y2) + 6px - self.top;
                viewbox-width: self.width / 1px;
                viewbox-height: self.height / 1px;
                commands: self.conflict
                    ? "M \{(self.x1 - self.left) / 1px} \{(self.y1 - self.top) / 1px} L \{(self.mid - self.left) / 1px} \{(self.y1 - self.top) / 1px} L \{(self.mid - self.left) / 1px} \{(self.gap-y - self.top) / 1px} L \{(self.x2 - 12px - self.left) / 1px} \{(self.gap-y - self.top) / 1px} L \{(self.x2 - 12px - self.left) / 1px} \{(self.y2 - self.top) / 1px} L \{(self.x2 - self.left) / 1px} \{(self.y2 - self.top) / 1px} M \{(self.x2 - self.left) / 1px - 5} \{(self.y2 - self.top) / 1px - 4} L \{(self.x2 - self.left) / 1px} \{(self.y2 - self.top) / 1px} L \{(self.x2 - self.left) / 1px - 5} \{(self.y2 - self.top) / 1px + 4}"
                    : "M \{(self.x1 - self.left) / 1px} \{(self.y1 - self.top) / 1px} L \{(self.mid - self.left) / 1px} \{(self.y1 - self.top) / 1px} L \{(self.mid - self.left) / 1px} \{(self.y2 - self.top) / 1px} L \{(self.x2 - self.left) / 1px} \{(self.y2 - self.top) / 1px} M \{(self.x2 - self.left) / 1px - 5} \{(self.y2 - self.top) / 1px - 4} L \{(self.x2 - self.left) / 1px} \{(self.y2 - self.top) / 1px} L \{(self.x2 - self.left) / 1px - 5} \{(self.y2 - self.top) / 1px + 4}";
                stroke: self.conflict ? AppTheme.destructive : AppTheme.secondary;
                stroke-width: 1.5px;
                fill: transparent;
            }
            // The summary card of the selected task, kept inside the visible chart.
            if root.selected-index >= 0 && root.selected-index < TasksUi.timeline-bars.length
                && TasksUi.timeline-bars[root.selected-index].id == root.selected-id : card := Rectangle {
                private property <TimelineBarRow> sel: TasksUi.timeline-bars[root.selected-index];
                private property <length> card-height: 192px + 22px * self.sel.links.length;
                width: 360px;
                height: self.card-height;
                x: max(-chart.content-x + 8px, min(-chart.content-x + chart.visible-width - self.width - 8px,
                    (self.sel.last-day + 1) * root.day-width + 12px));
                y: max(-chart.content-y + 8px, min(root.lane-height + (root.selected-index + 1) * root.row-height + 4px,
                    -chart.content-y + chart.visible-height - self.card-height - 8px));
                border-radius: 10px;
                border-width: 1px;
                border-color: AppTheme.border;
                background: AppTheme.surface;
                drop-shadow-blur: 14px;
                drop-shadow-color: #00000055;
                drop-shadow-offset-y: 4px;
                accessible-role: groupbox;
                accessible-label: self.sel.title;
                TouchArea { }
                Text {
                    x: 14px;
                    y: 10px;
                    width: parent.width - 56px;
                    height: 26px;
                    text: card.sel.title;
                    color: AppTheme.heading;
                    font-size: TypeScale.body;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                }
                TasksIconButton {
                    x: parent.width - 36px;
                    y: 8px;
                    width: 28px;
                    height: 28px;
                    icon: @image-url("../icons/lucide/outline/x.svg");
                    tooltip-text: @tr("Close");
                    clicked => { root.selected-id = -1; }
                }
                Rectangle {
                    x: 14px;
                    y: 42px;
                    width: min(parent.width - 28px, pill-text.preferred-width + 20px);
                    height: 24px;
                    border-radius: 12px;
                    background: card.sel.waiting-from >= 0 ? #d9770633 : card.sel.overdue ? AppTheme.destructive.with-alpha(0.15) : AppTheme.accent.with-alpha(0.15);
                    pill-text := Text {
                        x: 10px;
                        width: parent.width - 20px;
                        height: parent.height;
                        text: card.sel.waiting-from >= 0 && card.sel.no-reply-days >= 0 ? @tr("Waiting · no reply {} days", card.sel.no-reply-days)
                            : card.sel.overdue ? @tr("{} days late", card.sel.late-days)
                            : card.sel.done ? @tr("Done")
                            : card.sel.status;
                        color: card.sel.waiting-from >= 0 ? #d97706 : card.sel.overdue ? AppTheme.destructive : AppTheme.accent;
                        font-size: TypeScale.caption;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                Text {
                    x: 14px;
                    y: 72px;
                    width: parent.width - 28px;
                    height: 22px;
                    text: card.sel.milestone ? (card.sel.start-text != "" ? card.sel.start-text : card.sel.due-text)
                        : card.sel.start-text + " – " + card.sel.due-text + " · " + @tr("{} days", card.sel.day-count);
                    color: AppTheme.secondary;
                    font-size: TypeScale.caption;
                    vertical-alignment: center;
                    overflow: elide;
                }
                for link[k] in card.sel.links : Rectangle {
                    x: 14px;
                    y: 98px + k * 22px;
                    width: parent.width - 28px;
                    height: 22px;
                    Image {
                        x: 0px;
                        y: (parent.height - 14px) / 2;
                        width: 14px;
                        height: 14px;
                        source: link.kind == "event" ? @image-url("../icons/lucide/outline/calendar.svg")
                            : link.kind == "sent" ? @image-url("../icons/lucide/outline/paper-airplane.svg")
                            : @image-url("../icons/lucide/outline/mail.svg");
                        colorize: link.kind == "event" ? #8b5cf6 : AppTheme.accent;
                        accessible-role: none;
                    }
                    Text {
                        x: 22px;
                        width: parent.width - 22px;
                        height: parent.height;
                        text: (link.kind == "sent" ? @tr("Sent") : link.kind == "event" ? @tr("Event") : @tr("Received")) + "  " + link.text;
                        color: AppTheme.body;
                        font-size: TypeScale.caption;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                VerticalLayout {
                    x: 14px;
                    y: parent.height - 84px;
                    width: parent.width - 28px;
                    height: 72px;
                    spacing: 8px;
                    Button {
                        vertical-stretch: 1;
                        text: @tr("Open on board");
                        clicked => {
                            TasksUi.command("open-on-board", "task:" + card.sel.id, "");
                            root.selected-id = -1;
                        }
                    }
                    Button {
                        vertical-stretch: 1;
                        text: @tr("Email from task");
                        primary: true;
                        clicked => {
                            TasksUi.email-task(card.sel.id, card.sel.title);
                            root.selected-id = -1;
                        }
                    }
                }
            }
        }
        if TasksUi.timeline-bars.length == 0 : Text {
            y: root.header-height + 20px;
            width: parent.width;
            text: @tr("No task has a start or due date yet.");
            color: AppTheme.secondary;
            font-size: TypeScale.body;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }

    // Legend row under the chart.
    Rectangle {
        y: root.height - root.legend-height;
        width: parent.width;
        height: root.legend-height;
        background: AppTheme.sidebar-bg;
        Rectangle { width: parent.width; height: 1px; background: AppTheme.border; }
        HorizontalLayout {
            x: 12px;
            width: parent.width - 24px;
            spacing: 18px;
            alignment: start;
            HorizontalLayout {
                spacing: 6px;
                Rectangle { width: 26px; height: 10px; y: (parent.height - 10px) / 2; border-radius: 3px; background: AppTheme.accent.with-alpha(0.35);
                    Rectangle { width: parent.width / 2; border-radius: 3px; background: AppTheme.accent; } }
                Text { text: @tr("Done portion"); color: AppTheme.secondary; font-size: TypeScale.caption; vertical-alignment: center; }
            }
            HorizontalLayout {
                spacing: 6px;
                Path { width: 12px; height: 12px; y: (parent.height - 12px) / 2; viewbox-width: 16; viewbox-height: 16; commands: "M 8 0 L 16 8 L 8 16 L 0 8 Z"; fill: AppTheme.accent; }
                Text { text: @tr("Milestone"); color: AppTheme.secondary; font-size: TypeScale.caption; vertical-alignment: center; }
            }
            HorizontalLayout {
                spacing: 6px;
                Rectangle { width: 26px; height: 10px; y: (parent.height - 10px) / 2; border-radius: 3px; background: AppTheme.destructive; }
                Text { text: @tr("Overdue"); color: AppTheme.secondary; font-size: TypeScale.caption; vertical-alignment: center; }
            }
            HorizontalLayout {
                spacing: 6px;
                Rectangle { width: 22px; height: 1px; y: parent.height / 2; background: AppTheme.secondary; }
                Text { text: @tr("Depends on"); color: AppTheme.secondary; font-size: TypeScale.caption; vertical-alignment: center; }
            }
            if root.width >= 1100px : HorizontalLayout {
                spacing: 6px;
                TimelineHatch { width: 26px; height: 10px; y: (parent.height - 10px) / 2; border-radius: 3px; background: AppTheme.accent.with-alpha(0.25); line-colour: AppTheme.accent; }
                Text { text: @tr("Waiting on a reply"); color: AppTheme.secondary; font-size: TypeScale.caption; vertical-alignment: center; }
            }
            if root.width >= 1300px : HorizontalLayout {
                spacing: 6px;
                for pin in [
                    { kind: "mail", icon: @image-url("../icons/lucide/outline/mail.svg"), label: @tr("Received email") },
                    { kind: "sent", icon: @image-url("../icons/lucide/outline/paper-airplane.svg"), label: @tr("Sent email") },
                    { kind: "event", icon: @image-url("../icons/lucide/outline/calendar.svg"), label: @tr("Calendar event") },
                ] : HorizontalLayout {
                    spacing: 4px;
                    Image { width: 12px; height: 12px; y: (parent.height - 12px) / 2; source: pin.icon; colorize: pin.kind == "event" ? #8b5cf6 : AppTheme.accent; }
                    Text { text: pin.label; color: AppTheme.secondary; font-size: TypeScale.caption; vertical-alignment: center; }
                }
            }
            if root.width >= 1600px : Text {
                text: @tr("No reply · {}d", 3);
                color: AppTheme.destructive;
                font-size: TypeScale.caption;
                vertical-alignment: center;
            }
            if root.width >= 2000px : Text {
                text: @tr("Drag a bar to reschedule · drag its edge to change the due date");
                color: AppTheme.muted;
                font-size: TypeScale.caption;
                vertical-alignment: center;
            }
        }
    }
}

component TasksSidebar inherits Rectangle {
    callback navigate(string);
    callback new-task;
    background: AppTheme.sidebar-bg;

    VerticalLayout {
        padding-top: LayoutMetrics.sidebar-action-top;
        padding-left: LayoutMetrics.sidebar-inset;
        padding-right: LayoutMetrics.sidebar-inset;
        padding-bottom: 12px;
        spacing: 8px;
        Button {
            height: LayoutMetrics.sidebar-action-height;
            text: @tr("New task");
            primary: true;
            has-icon: true;
            label-overflow: elide;
            icon: @image-url("../icons/lucide/outline/plus.svg");
            clicked => { root.new-task(); }
        }
        LineEdit {
            height: 34px;
            show-leading-icon: true;
            leading-icon: @image-url("../icons/lucide/outline/search.svg");
            placeholder-text: @tr("Find list, project or context");
            input-label: @tr("Find list, project or context");
            edited(text) => { TasksUi.command("nav-filter", text, ""); }
        }
        ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            horizontal-scrollbar-policy: always-off;
            VerticalLayout {
                spacing: 4px;
                alignment: start;
                WorkspaceMiniHeading { label: @tr("FOCUS"); }
                for row in TasksUi.focus-rows : TasksNavItem {
                    label: TasksText.focus-label(row.key);
                    count: row.count;
                    // The Inbox count stands out when something is waiting.
                    muted-color: row.key == "focus:inbox" && row.count != "" && row.count != "0" ? AppTheme.accent : AppTheme.muted;
                    left-padding: 12px;
                    icon: TasksText.focus-icon(row.key);
                    icon-color: TasksUi.selection == row.key ? AppTheme.accent : row.colour;
                    selected: TasksUi.selection == row.key;
                    clicked(scope) => { root.navigate(row.key); }
                }
                WorkspaceMiniHeading { label: @tr("PROJECTS"); }
                for row in TasksUi.projects : TasksNavItem {
                    label: row.label;
                    count: row.count;
                    left-padding: 12px;
                    icon: @image-url("../icons/lucide/filled/project-dot.svg");
                    icon-color: row.colour;
                    selected: TasksUi.selection == row.key;
                    clicked(scope) => { root.navigate(row.key); }
                }
                if TasksUi.creating == "project" : LineEdit {
                    placeholder-text: @tr("Project name");
                    input-label: @tr("Project name");
                    accepted(text) => { TasksUi.command("create-project", text, ""); TasksUi.creating = ""; }
                }
                if TasksUi.creating != "project" : TasksNavItem {
                    label: @tr("New project");
                    left-padding: 12px;
                    icon: @image-url("../icons/lucide/outline/plus.svg");
                    clicked(scope) => { TasksUi.creating = "project"; }
                }
                WorkspaceMiniHeading { label: @tr("CONTEXTS"); }
                for row in TasksUi.contexts : TasksNavItem {
                    label: "@" + row.label;
                    count: row.count;
                    left-padding: 12px;
                    icon: @image-url("../icons/lucide/filled/tag.svg");
                    selected: TasksUi.selection == row.key;
                    clicked(scope) => { root.navigate(row.key); }
                }
                if TasksUi.creating == "context" : LineEdit {
                    placeholder-text: @tr("Context name");
                    input-label: @tr("Context name");
                    accepted(text) => { TasksUi.command("create-context", text, ""); TasksUi.creating = ""; }
                }
                if TasksUi.creating != "context" : TasksNavItem {
                    label: @tr("New context");
                    left-padding: 12px;
                    icon: @image-url("../icons/lucide/outline/plus.svg");
                    clicked(scope) => { TasksUi.creating = "context"; }
                }
            }
        }
    }
}

// A small rounded status tag with a dot, as on the design's cards.
// A small palette to click, beside the box that takes any #rrggbb.
component TasksSwatches inherits Rectangle {
    callback picked(string);
    callback picked-colour(color);
    in property <string> selected-hex;
    height: 54px;
    for sw[i] in TasksText.palette : Rectangle {
        x: mod(i, 10) * 24px;
        y: floor(i / 10) * 26px + 2px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: sw.c;
        border-width: root.selected-hex == sw.hex ? 3px : 0px;
        border-color: AppTheme.heading;
        TouchArea {
            accessible-role: button;
            accessible-label: sw.hex;
            mouse-cursor: pointer;
            clicked => {
                root.picked(sw.hex);
                root.picked-colour(sw.c);
            }
        }
    }
}

component TaskPill inherits HorizontalLayout {
    in property <string> text;
    in property <color> tone;
    alignment: start;
    Rectangle {
        height: 20px;
        width: pill-text.x + pill-text.preferred-width + 8px;
        border-radius: 10px;
        background: root.tone.with-alpha(0.14);
        Rectangle {
            x: 7px;
            y: (parent.height - 6px) / 2;
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: root.tone;
        }
        pill-text := Text {
            x: 17px;
            height: parent.height;
            text: root.text;
            color: root.tone;
            font-size: TypeScale.micro;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

component TaskCard inherits Rectangle {
    in property <TaskCardRow> card;
    // The keyboard cursor is on this card.
    in property <bool> cursor: false;
    // A card dropped on this one lands right below it (id of the dragged task).
    in property <bool> drop-enabled: true;
    callback dropped-on(string);
    callback open;
    callback toggle-done;
    callback delete-task;
    callback menu-action(string);

    private property <length> pad: 10px;
    height: content.preferred-height + 2 * root.pad;
    border-radius: LayoutMetrics.corner-radius;
    border-width: root.cursor || (TasksUi.detail-open && TasksUi.detail.id == root.card.id) ? 2px : 1px;
    border-color: root.cursor || (TasksUi.detail-open && TasksUi.detail.id == root.card.id) ? AppTheme.accent : AppTheme.border;
    background: AppTheme.surface;
    opacity: root.card.done ? 0.75 : 1;
    accessible-role: list-item;
    accessible-label: root.card.title;
    // What the sighted user reads on the card, in one sentence for a screen reader.
    accessible-description:
        (root.card.done ? @tr("Done") + ". " : "")
        + (root.card.status != "" ? root.card.status + ". " : "")
        + (root.card.due != "" ? @tr("Due {}", root.card.due-kind != "" ? TasksUi.due-kind-title(root.card.due-kind) : root.card.due) + ". " : "")
        + (root.card.high-priority ? @tr("High priority") + ". " : "")
        + (root.card.no-reply-days >= 0 ? @tr("No reply · {}d", root.card.no-reply-days) + ". " : "")
        + (root.card.checklist-total > 0 ? @tr("{}/{} done", root.card.checklist-done, root.card.checklist-total) + ". " : "")
        + (root.card.link-count > 0 ? @tr("{} linked", root.card.link-count) + ". " : "");
    accessible-action-default => { root.open(); }

    card-drop := DropArea {
        enabled: root.drop-enabled;
        can-drop(event) => { DragAction.move }
        dropped(event) => {
            root.dropped-on(TasksUi.text-of(event.data));
            return event.proposed-action;
        }
    }

    // A dropped card lands right below this one.
    Rectangle {
        visible: card-drop.has-drag;
        x: 6px;
        y: parent.height - 2px;
        width: parent.width - 12px;
        height: 3px;
        border-radius: 1.5px;
        background: AppTheme.accent;
    }

    DragArea {
        allow-move: true;
        data: TasksUi.to-transfer("" + root.card.id);
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.open(); }
        }
    }

    content := VerticalLayout {
        x: root.pad;
        y: root.pad;
        width: parent.width - 2 * root.pad;
        height: parent.height - 2 * root.pad;
        spacing: 6px;
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                width: 22px;
                height: 22px;
                done-button := TasksIconButton {
                    width: 22px;
                    height: 22px;
                    icon: root.card.done ? @image-url("../icons/lucide/filled/tasks.svg") : @image-url("../icons/lucide/outline/tasks.svg");
                    icon-color: root.card.done ? AppTheme.accent : AppTheme.secondary;
                    tooltip-text: root.card.done ? @tr("Reopen task") : @tr("Complete task");
                    clicked => { root.toggle-done(); }
                }
            }
            Text {
                horizontal-stretch: 1;
                text: root.card.done && root.card.struck-title != "" ? root.card.struck-title : root.card.title;
                color: AppTheme.heading;
                font-size: TypeScale.body;
                font-weight: 600;
                wrap: word-wrap;
                vertical-alignment: center;
            }
            ActionMenu {
                width: 22px;
                height: 22px;
                icon: @image-url("../icons/lucide/outline/kebab-horizontal.svg");
                entries: TasksUi.card-menu;
                menu-width: 220px;
                tooltip-text: @tr("Move to column");
                activated(id) => { root.menu-action(id); }
            }
            TasksIconButton {
                width: 22px;
                height: 22px;
                icon: @image-url("../icons/lucide/outline/trash.svg");
                tooltip-text: @tr("Delete task");
                clicked => { root.delete-task(); }
            }
        }
        if root.card.status != "" && !TasksUi.compact-cards : Text {
            text: root.card.status;
            color: AppTheme.secondary;
            font-size: TypeScale.micro;
            font-weight: 600;
        }
        if root.card.link-kind != "" && !TasksUi.compact-cards : Rectangle {
            height: 26px;
            border-radius: 6px;
            background: AppTheme.sidebar-bg;
            Image {
                x: 8px;
                y: (parent.height - 12px) / 2;
                width: 12px;
                height: 12px;
                source: root.card.link-kind == "mail_received" ? @image-url("../icons/lucide/outline/mail.svg")
                    : root.card.link-kind == "mail_sent" ? @image-url("../icons/lucide/outline/paper-airplane.svg")
                    : @image-url("../icons/lucide/outline/calendar.svg");
                colorize: AppTheme.accent;
            }
            Text {
                x: 26px;
                width: parent.width - 34px;
                height: parent.height;
                text: (root.card.link-kind == "mail_received" ? @tr("Mail")
                    : root.card.link-kind == "mail_sent" ? @tr("Sent")
                    : @tr("Event")) + ": " + root.card.link-text
                    + (root.card.link-more > 0 ? "  +" + root.card.link-more : "");
                color: AppTheme.secondary;
                font-size: TypeScale.micro;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        if root.card.label-list.length > 0 && !TasksUi.compact-cards : HorizontalLayout {
            spacing: 4px;
            alignment: start;
            for name[i] in root.card.label-list : Rectangle {
                visible: i < 2;
                height: 20px;
                width: i < 2 ? min(chip-text.preferred-width + 14px, 110px) : 0px;
                border-radius: 4px;
                background: AppTheme.accent-soft;
                chip-text := Text {
                    x: 7px;
                    width: parent.width - 14px;
                    height: parent.height;
                    text: name;
                    color: AppTheme.accent;
                    font-size: TypeScale.micro;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            if root.card.label-list.length > 2 : Text {
                text: "+" + (root.card.label-list.length - 2);
                color: AppTheme.secondary;
                font-size: TypeScale.micro;
                vertical-alignment: center;
            }
        }
        if root.card.no-reply-days >= 0 && !TasksUi.compact-cards : TaskPill {
            text: @tr("No reply · {}d", root.card.no-reply-days);
            tone: AppTheme.destructive;
        }
        if root.card.follow-up != "" && !TasksUi.compact-cards : HorizontalLayout {
            spacing: 3px;
            alignment: start;
            Image {
                y: (parent.height - 11px) / 2;
                width: 11px;
                height: 11px;
                source: @image-url("../icons/lucide/outline/history.svg");
                colorize: AppTheme.secondary;
            }
            Text {
                text: @tr("Follow up {}", root.card.follow-up);
                color: AppTheme.secondary;
                font-size: TypeScale.micro;
            }
        }
        if root.card.quick-capture && !TasksUi.compact-cards : TaskPill {
            text: @tr("Quick capture");
            tone: AppTheme.secondary;
        }
        if root.card.replied && !TasksUi.compact-cards : TaskPill {
            text: @tr("Reply received");
            tone: AppTheme.accent;
        }
        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            if root.card.due != "" : HorizontalLayout {
                spacing: 3px;
                Image {
                    y: (parent.height - 11px) / 2;
                    width: 11px;
                    height: 11px;
                    source: @image-url("../icons/lucide/outline/history.svg");
                    colorize: root.card.due-warn ? AppTheme.destructive : AppTheme.secondary;
                }
                Text {
                    text: root.card.due-kind != "" ? TasksUi.due-kind-title(root.card.due-kind) : root.card.due;
                    color: root.card.due-warn ? AppTheme.destructive : AppTheme.secondary;
                    font-size: TypeScale.micro;
                }
            }
            if root.card.checklist-total > 0 && !TasksUi.compact-cards : Text {
                text: @tr("{}/{} done", root.card.checklist-done, root.card.checklist-total);
                color: AppTheme.secondary;
                font-size: TypeScale.micro;
            }
            if root.card.link-count > 0 && !TasksUi.compact-cards : Text {
                text: @tr("{} linked", root.card.link-count);
                color: AppTheme.secondary;
                font-size: TypeScale.micro;
            }
        }
        if (root.card.from-mail || root.card.high-priority || root.card.context != "" || root.card.assignee != "") && !TasksUi.compact-cards : HorizontalLayout {
            spacing: 10px;
            if root.card.from-mail : Text {
                text: @tr("From email");
                color: AppTheme.secondary;
                font-size: TypeScale.micro;
                vertical-alignment: center;
            }
            if root.card.high-priority : Text {
                text: @tr("High");
                color: AppTheme.destructive;
                font-size: TypeScale.micro;
                font-weight: 700;
                vertical-alignment: center;
            }
            if root.card.context != "" : Text {
                text: "@" + root.card.context;
                color: AppTheme.secondary;
                font-size: TypeScale.micro;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle { horizontal-stretch: 1; }
            if root.card.assignee != "" : Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 10px;
                background: AppTheme.avatar-selected-bg;
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.card.assignee;
                    color: AppTheme.title;
                    font-size: 9px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            for more[i] in root.card.more-assignees : Rectangle {
                visible: i < 2;
                width: i < 2 ? 20px : 0px;
                height: 20px;
                border-radius: 10px;
                background: AppTheme.avatar-selected-bg;
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: more;
                    color: AppTheme.title;
                    font-size: 9px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            if root.card.more-assignees.length > 2 : Text {
                text: "+" + (root.card.more-assignees.length - 2);
                color: AppTheme.secondary;
                font-size: TypeScale.micro;
                vertical-alignment: center;
            }
        }
    }
}

component TaskColumnView inherits Rectangle {
    in property <TaskColumnRow> column;
    // A card was clicked: the board takes keyboard focus there.
    callback card-used(int);
    in property <length> column-width: 272px;
    private property <bool> adding: TasksUi.adding-column == root.column.id;
    // "" | "rename" | "wip" | "colour": inline editor under the header.
    private property <string> editing: "";
    private property <[ActionMenuEntry]> options: [
        { id: "rename", title: @tr("Rename column") },
        { id: "wip", title: @tr("Set task limit") },
        { id: "left", title: @tr("Move left") },
        { id: "right", title: @tr("Move right") },
        { id: "colour:#6b7280", title: @tr("Colour: Grey") },
        { id: "colour:#3b82f6", title: @tr("Colour: Blue") },
        { id: "colour:#22c55e", title: @tr("Colour: Green") },
        { id: "colour:#f59e0b", title: @tr("Colour: Orange") },
        { id: "colour:#ef4444", title: @tr("Colour: Red") },
        { id: "custom-colour", title: @tr("Custom colour…") },
        { id: "icon:inbox", title: @tr("Icon: Inbox") },
        { id: "icon:bolt", title: @tr("Icon: Star") },
        { id: "icon:hourglass", title: @tr("Icon: Clock") },
        { id: "icon:calendar", title: @tr("Icon: Calendar") },
        { id: "icon:check", title: @tr("Icon: Check") },
        { id: "icon:moon", title: @tr("Icon: Archive") },
        { id: "icon:mail", title: @tr("Icon: Mail") },
        { id: "icon:alert", title: @tr("Icon: Alert") },
        { id: "icon:people", title: @tr("Icon: People") },
        { id: "icon:tasks", title: @tr("Icon: Tasks") },
        { id: "delete", title: @tr("Delete column"), disabled: root.column.fixed, destructive: true },
    ];

    width: root.column.collapsed ? 46px : root.column-width;
    border-radius: LayoutMetrics.corner-radius;
    background: AppTheme.sidebar-bg;
    animate width { duration: 160ms; easing: ease-out; }

    if root.column.collapsed : Rectangle {
        TouchArea {
            clicked => { TasksUi.command("collapse", "" + root.column.id, "0"); }
            accessible-role: button;
            accessible-label: root.column.name + " " + root.column.count;
        }
        VerticalLayout {
            padding: 10px;
            spacing: 8px;
            alignment: start;
            Text {
                text: root.column.count;
                color: AppTheme.secondary;
                font-size: TypeScale.caption;
                horizontal-alignment: center;
            }
            Text {
                text: root.column.name;
                color: AppTheme.heading;
                font-size: TypeScale.caption;
                font-weight: 600;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }

    if !root.column.collapsed : VerticalLayout {
        padding: 10px;
        spacing: 8px;
        HorizontalLayout {
            height: 28px;
            spacing: 8px;
            Rectangle {
                width: 16px;
                Image {
                    y: (parent.height - self.height) / 2;
                    width: 16px;
                    height: 16px;
                    source: TasksText.column-icon(root.column.icon);
                    colorize: root.column.colour;
                    visible: root.column.id >= 0;
                }
                Rectangle {
                    x: 3px;
                    y: (parent.height - self.height) / 2;
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: root.column.colour;
                    visible: root.column.id < 0;
                }
            }
            Text {
                horizontal-stretch: 1;
                text: root.column.name != "" ? root.column.name
                    : TasksUi.title != "" ? TasksUi.title : TasksText.focus-label(TasksUi.selection);
                color: AppTheme.heading;
                font-size: TypeScale.body;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                text: root.column.count;
                color: root.column.over-wip ? AppTheme.destructive : AppTheme.secondary;
                font-size: TypeScale.caption;
                vertical-alignment: center;
            }
            TasksIconButton {
                width: 26px;
                height: 26px;
                icon: @image-url("../icons/lucide/outline/plus.svg");
                tooltip-text: @tr("Add task");
                clicked => { TasksUi.adding-column = root.column.id; }
            }
            if root.column.id >= 0 : ActionMenu {
                width: 26px;
                height: 26px;
                icon: @image-url("../icons/lucide/outline/kebab-horizontal.svg");
                entries: root.options;
                menu-width: 200px;
                tooltip-text: @tr("Column options");
                activated(id) => {
                    if id == "rename" || id == "wip" || id == "custom-colour" {
                        root.editing = id == "custom-colour" ? "colour" : id;
                    } else {
                        TasksUi.command("column-" + (id == "delete" ? "delete" : id == "left" || id == "right" ? "move" : id.starts-with("icon:") ? "icon" : "colour"),
                            "" + root.column.id, id);
                    }
                }
            }
            if root.column.id >= 0 : TasksIconButton {
                width: 26px;
                height: 26px;
                icon: @image-url("../icons/lucide/outline/chevron-left.svg");
                tooltip-text: @tr("Collapse column");
                clicked => { TasksUi.command("collapse", "" + root.column.id, "1"); }
            }
        }
        if root.editing != "" : LineEdit {
            text: root.editing == "rename" ? root.column.name : root.editing == "colour" ? "" : root.column.wip-limit > 0 ? "" + root.column.wip-limit : "";
            placeholder-text: root.editing == "rename" ? @tr("Column name") : root.editing == "colour" ? @tr("Colour as #rrggbb") : @tr("Task limit (empty = none)");
            input-label: root.editing == "rename" ? @tr("Column name") : root.editing == "colour" ? @tr("Colour as #rrggbb") : @tr("Task limit (empty = none)");
            accepted(text) => {
                TasksUi.command(root.editing == "rename" ? "column-rename" : root.editing == "colour" ? "column-colour" : "column-wip", "" + root.column.id, root.editing == "colour" ? "colour:" + text : text);
                root.editing = "";
            }
        }
        if root.editing == "colour" : TasksSwatches {
            picked(hex) => {
                TasksUi.command("column-colour", "" + root.column.id, "colour:" + hex);
                root.editing = "";
            }
        }
        if root.adding : LineEdit {
            placeholder-text: @tr("Task title");
            input-label: @tr("Task title");
            accepted(text) => {
                TasksUi.command("add-task", "" + root.column.id, text);
                TasksUi.adding-column = -2;
            }
        }
        column-drop := DropArea {
            vertical-stretch: 1;
            enabled: root.column.id >= 0;
            can-drop(event) => { DragAction.move }
            dropped(event) => {
                TasksUi.command("card-menu", TasksUi.text-of(event.data), "move:" + root.column.id);
                return event.proposed-action;
            }
        ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            horizontal-scrollbar-policy: always-off;
            VerticalLayout {
                spacing: 8px;
                alignment: start;
                // A dropped card lands above the first one.
                if root.column.id >= 0 && root.column.cards.length > 0 : Rectangle {
                    height: 10px;
                    top-drop := DropArea {
                        can-drop(event) => { DragAction.move }
                        dropped(event) => {
                            TasksUi.command("card-menu", TasksUi.text-of(event.data), "move:" + root.column.id);
                            return event.proposed-action;
                        }
                    }
                    Rectangle {
                        visible: top-drop.has-drag;
                        y: 3px;
                        x: 6px;
                        width: parent.width - 12px;
                        height: 3px;
                        border-radius: 1.5px;
                        background: AppTheme.accent;
                    }
                }
                for card in root.column.cards : TaskCard {
                    card: card;
                    cursor: TasksUi.board-focused && TasksUi.cursor == card.id;
                    drop-enabled: root.column.id >= 0;
                    dropped-on(dragged) => { TasksUi.command("card-menu", dragged, "after:" + root.column.id + ":" + card.id); }
                    open => { root.card-used(card.id); TasksUi.command("open", "" + card.id, ""); }
                    toggle-done => { TasksUi.command(card.done ? "reopen" : "complete", "" + card.id, ""); }
                    delete-task => { TasksUi.command("delete", "" + card.id, ""); }
                    menu-action(id) => { TasksUi.command("card-menu", "" + card.id, id); }
                }
                // The design's "+ Add task" row under the last card.
                if root.column.id >= 0 && !root.adding : Rectangle {
                    height: 32px;
                    add-touch := TouchArea {
                        clicked => { TasksUi.adding-column = root.column.id; }
                    }
                    Rectangle {
                        background: add-touch.has-hover ? AppTheme.selected-row : transparent;
                        border-radius: LayoutMetrics.corner-radius;
                    }
                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        height: parent.height;
                        text: "+  " + @tr("Add task");
                        color: AppTheme.secondary;
                        font-size: TypeScale.secondary;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    accessible-role: button;
                    accessible-label: @tr("Add task");
                    accessible-action-default => { TasksUi.adding-column = root.column.id; }
                }
            }
        }
            // Where a dragged card would land.
            Rectangle {
                visible: column-drop.has-drag;
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                border-width: 2px;
                border-color: AppTheme.accent;
                border-radius: LayoutMetrics.corner-radius;
                background: AppTheme.accent.with-alpha(0.08);
            }
        }
    }
}

component DetailSection inherits Text {
    color: AppTheme.muted;
    font-size: TypeScale.micro;
    font-weight: 700;
}

// A round icon for the kind of activity, on a line that runs to the next entry.
component TrailMarker inherits Rectangle {
    in property <string> kind;
    in property <bool> first;
    in property <bool> last;
    width: 22px;
    Rectangle {
        x: 10px;
        y: 20px;
        width: 2px;
        height: parent.height - 20px;
        background: AppTheme.border;
        visible: !root.last;
    }
    Rectangle {
        x: 0px;
        y: 0px;
        width: 22px;
        height: 22px;
        border-radius: 11px;
        background: root.first ? AppTheme.accent-soft : AppTheme.sidebar-bg;
        border-width: 1px;
        border-color: root.first ? AppTheme.accent : AppTheme.control-border;
        Image {
            x: 5px;
            y: 5px;
            width: 12px;
            height: 12px;
            source: root.kind == "pending-follow" ? @image-url("../icons/lucide/outline/calendar.svg")
                : root.kind == "pending-reply" ? @image-url("../icons/lucide/outline/mail.svg")
                : root.kind == "created" ? @image-url("../icons/lucide/outline/tasks.svg")
                : root.kind == "sent" ? @image-url("../icons/lucide/outline/paper-airplane.svg")
                : root.kind == "linked" || root.kind == "unlinked" ? @image-url("../icons/lucide/outline/link.svg")
                : root.kind == "moved" ? @image-url("../icons/lucide/outline/sync.svg")
                : root.kind == "reopened" ? @image-url("../icons/lucide/outline/undo.svg")
                : root.kind == "labels" ? @image-url("../icons/lucide/filled/tag.svg")
                : @image-url("../icons/lucide/outline/pencil.svg");
            colorize: root.first ? AppTheme.accent : AppTheme.secondary;
        }
    }
}

// Steps still to come, greyed, above the entries that happened.
component PendingTrail inherits VerticalLayout {
    spacing: 0px;
    if TasksUi.detail.follow-up != "" && !TasksUi.detail.done : HorizontalLayout {
        spacing: 10px;
        TrailMarker { kind: "pending-follow"; first: false; last: false; }
        VerticalLayout {
            padding-bottom: 14px;
            spacing: 1px;
            Text { text: @tr("Follow up"); color: AppTheme.muted; font-size: TypeScale.caption; font-weight: 700; wrap: word-wrap; }
            Text { text: @tr("If there is no reply by {}", TasksUi.detail.follow-up); color: AppTheme.muted; font-size: TypeScale.micro; wrap: word-wrap; }
        }
    }
    if TasksUi.detail.waiting-days >= 0 : HorizontalLayout {
        spacing: 10px;
        TrailMarker { kind: "pending-reply"; first: false; last: false; }
        VerticalLayout {
            padding-bottom: 14px;
            spacing: 1px;
            Text { text: @tr("Reply expected"); color: AppTheme.muted; font-size: TypeScale.caption; font-weight: 700; wrap: word-wrap; }
            Text { text: TasksUi.detail.move-back ? @tr("The task moves back when it arrives") : @tr("Awaiting reply · {}d", TasksUi.detail.waiting-days); color: AppTheme.muted; font-size: TypeScale.micro; wrap: word-wrap; }
        }
    }
}

component TaskDrawer inherits Rectangle {
    in property <bool> compact: false;
    background: AppTheme.surface;
    clip: true;

    // Edits stay local until Save so a reload never overwrites typing.
    in-out property <string> title-draft;
    in-out property <string> description-draft;
    in-out property <string> due-draft;
    in-out property <string> start-draft;
    in-out property <string> label-name;
    in-out property <string> label-hex: "#4a86e8";
    in-out property <int> label-editing: -1;
    in-out property <bool> label-edit-open: false;
    in-out property <int> label-focus: 0;
    in-out property <color> label-colour: #4a86e8;
    in-out property <bool> assignee-open: false;
    in-out property <bool> check-adding: false;
    in-out property <string> assignee-draft;
    in-out property <string> link-draft;
    in-out property <bool> link-adding;
    in-out property <bool> desc-editing: false;
    in-out property <string> picker-for: "due";
    // Room the docked composer takes from the right of the task page.
    private property <length> dock-reserve: TasksUi.detail-expanded && TaskComposeUi.active && TaskComposeUi.docked ? 500px : 0px;
    in-out property <string> link-kind: "depends";
    function reset-drafts() {
        root.title-draft = TasksUi.detail.title;
        root.description-draft = TasksUi.detail.description;
        root.due-draft = TasksUi.detail.due;
        root.start-draft = TasksUi.detail.start;
        root.assignee-open = false;
        root.check-adding = false;
        root.assignee-draft = "";
        TasksUi.assignee-suggestions = [];
        root.link-adding = false;
        root.desc-editing = false;
    }
    init => { root.reset-drafts(); }
    private property <int> shown-id: -1;
    private property <length> footer-height: TasksUi.links.length > 0 ? 138px : 98px;
    private property <int> detail-id: TasksUi.detail.id;
    changed detail-id => { root.reset-drafts(); }

    Rectangle {
        x: 0px;
        width: LayoutMetrics.divider-width;
        background: AppTheme.border;
    }

    ScrollView {
        x: 1px;
        y: 0px;
        width: parent.width - 1px;
        height: parent.height - root.footer-height;
        content-width: self.visible-width;
        horizontal-scrollbar-policy: always-off;
        HorizontalLayout {
          x: 0px;
          y: 0px;
          padding: 16px;
          spacing: 32px;
          alignment: start;
          VerticalLayout {
            spacing: 10px;
            alignment: start;
            width: min(640px, root.width - 45px - root.dock-reserve);
            HorizontalLayout {
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: TasksUi.detail.project + " / " + TasksUi.detail.column;
                    color: AppTheme.secondary;
                    font-size: TypeScale.caption;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if TasksUi.detail-expanded : Rectangle {
                    width: timeline-link.preferred-width + 16px;
                    timeline-link := Text {
                        x: 8px;
                        text: @tr("Show on timeline");
                        color: AppTheme.accent;
                        font-size: TypeScale.caption;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        accessible-role: button;
                        accessible-label: @tr("Show on timeline");
                        mouse-cursor: pointer;
                        clicked => {
                            TasksUi.detail-expanded = false;
                            TasksUi.command("view", "timeline", "");
                        }
                    }
                }
                ActionMenu {
                    width: 32px;
                    height: 32px;
                    icon: @image-url("../icons/lucide/outline/kebab-horizontal.svg");
                    entries: TasksUi.detail-menu;
                    menu-width: 220px;
                    tooltip-text: @tr("Move to column");
                    activated(id) => {
                        if id == "priority" {
                            TasksUi.command("toggle-priority", "" + TasksUi.detail.id, "");
                        } else if id == "delete" {
                            TasksUi.command("delete", "" + TasksUi.detail.id, "");
                        } else {
                            TasksUi.command("card-menu", "" + TasksUi.detail.id, id);
                        }
                    }
                }
                if !root.compact : TasksIconButton {
                    width: 32px;
                    height: 32px;
                    icon: @image-url("../icons/lucide/outline/screen-full.svg");
                    tooltip-text: TasksUi.detail-expanded ? @tr("Back to the side panel") : @tr("Open as a page");
                    clicked => {
                        if !TasksUi.detail-expanded && TabsUi.enabled {
                            // The page opens in a tab of its own.
                            TabsUi.open-task(TasksUi.detail.id, TasksUi.detail.title);
                        } else {
                            TasksUi.detail-expanded = !TasksUi.detail-expanded;
                        }
                    }
                }
                TasksIconButton {
                    width: 32px;
                    height: 32px;
                    icon: @image-url("../icons/lucide/outline/x.svg");
                    tooltip-text: @tr("Close");
                    clicked => {
                        TasksUi.detail-expanded = false;
                        TasksUi.command("close-detail", "", "");
                    }
                }
            }
            // Large heading, edited in place (mockup 2/3).
            Rectangle {
                height: max(34px, title-input.preferred-height + 8px);
                border-radius: 6px;
                border-width: title-input.has-focus ? 1px : 0px;
                border-color: AppTheme.accent;
                title-input := TextInput {
                    x: 4px;
                    y: 4px;
                    width: parent.width - 8px;
                    text <=> root.title-draft;
                    font-size: 22px;
                    font-weight: 700;
                    color: AppTheme.heading;
                    wrap: word-wrap;
                    single-line: false;
                    accessible-role: text-input;
                    accessible-label: @tr("Task title");
                    accepted => { TasksUi.save-detail("" + TasksUi.detail.id, root.title-draft, root.description-draft, root.due-draft); }
                }
            }
            // Label chips under the title: the tag button opens the label popup;
            // the chips wrap onto further lines.
            Rectangle {
                private property <[ChipPos]> flow: TasksUi.chip-flow(TasksUi.label-rows, self.width, 0.62rem);
                height: flow.length > 0 ? flow[0].h : 28px;
                label-anchor := Rectangle {
                    x: 0px;
                    y: 0px;
                    width: 28px;
                    height: 28px;
                    TasksIconButton {
                        width: parent.width;
                        height: parent.height;
                        icon: @image-url("../icons/lucide/filled/tag.svg");
                        tooltip-text: @tr("Manage labels");
                        clicked => {
                            TasksUi.label-query = "";
                            root.label-edit-open = false;
                            TasksUi.command("label-search", "", "");
                            label-popup.show();
                            root.label-focus += 1;
                        }
                    }
                    label-popup := PopupWindow {
                        x: max(8px - label-anchor.absolute-position.x, parent.width - self.width);
                        y: parent.height + 4px;
                        width: 288px;
                        height: root.label-edit-open ? 196px : 156px + max(64px, min(174px, TasksUi.label-shown * 34px));
                        close-policy: close-on-click-outside;
                        Rectangle {
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: AppTheme.border;
                            background: AppTheme.surface;
                            drop-shadow-blur: 18px;
                            drop-shadow-offset-y: 5px;
                            drop-shadow-color: #0000002e;
                            clip: true;
                            if !root.label-edit-open : VerticalLayout {
                                padding: 8px;
                                spacing: 8px;
                                Text {
                                    height: 28px;
                                    text: @tr("Labels");
                                    color: AppTheme.heading;
                                    font-size: TypeScale.subtitle;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                label-search-field := LineEdit {
                                    height: 36px;
                                    text <=> TasksUi.label-query;
                                    focus-request: root.label-focus;
                                    placeholder-text: @tr("Search labels");
                                    input-label: @tr("Search labels");
                                    edited(value) => { TasksUi.command("label-search", value, ""); }
                                }
                                Rectangle { height: 1px; background: AppTheme.border; }
                                Rectangle {
                                    vertical-stretch: 1;
                                    label-list := ScrollView {
                                        x: 0px;
                                        y: 0px;
                                        width: parent.width;
                                        height: parent.height;
                                        content-width: self.visible-width;
                                        horizontal-scrollbar-policy: always-off;
                                        VerticalLayout {
                                        x: 0px;
                                        y: 0px;
                                        alignment: start;
                                        spacing: 0px;
                                        for label in TasksUi.label-rows : Rectangle {
                                            height: label.shown ? 34px : 0px;
                                            visible: label.shown;
                                            border-radius: 6px;
                                            background: label-hit.has-hover ? AppTheme.sidebar-bg : transparent;
                                            Image {
                                                x: 8px;
                                                y: (parent.height - self.height) / 2;
                                                width: 16px;
                                                height: 16px;
                                                source: @image-url("../icons/lucide/filled/tag.svg");
                                                colorize: label.colour;
                                            }
                                            Text {
                                                x: 32px;
                                                width: parent.width - 32px - 64px;
                                                height: parent.height;
                                                text: label.name;
                                                color: AppTheme.heading;
                                                font-size: TypeScale.body;
                                                font-weight: label.applied ? 600 : 500;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                            Image {
                                                x: parent.width - 58px;
                                                y: (parent.height - self.height) / 2;
                                                width: 18px;
                                                height: 18px;
                                                visible: label.applied;
                                                source: @image-url("../icons/lucide/outline/check.svg");
                                                colorize: AppTheme.accent;
                                            }
                                            label-hit := TouchArea {
                                                width: parent.width - 40px;
                                                accessible-role: checkbox;
                                                accessible-label: label.name;
                                                accessible-checked: label.applied;
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    TasksUi.command("detail-label", "" + TasksUi.detail.id, "lbl:" + label.id);
                                                    label-popup.close();
                                                }
                                            }
                                            TasksIconButton {
                                                x: parent.width - 34px;
                                                y: (parent.height - 28px) / 2;
                                                width: 28px;
                                                height: 28px;
                                                icon: @image-url("../icons/lucide/outline/pencil.svg");
                                                tooltip-text: @tr("Edit label");
                                                clicked => {
                                                    root.label-editing = label.id;
                                                    root.label-name = label.name;
                                                    root.label-hex = label.hex;
                                                    root.label-colour = label.colour;
                                                    root.label-edit-open = true;
                                                }
                                            }
                                        }
                                        }
                                    }
                                    if TasksUi.label-rows.length == 0 : Text {
                                        width: parent.width;
                                        height: 64px;
                                        text: @tr("No matching labels");
                                        color: AppTheme.muted;
                                        font-size: TypeScale.body;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                Rectangle { height: 1px; background: AppTheme.border; }
                                Button {
                                    height: 34px;
                                    text: @tr("Create label…");
                                    has-icon: true;
                                    icon: @image-url("../icons/lucide/outline/plus.svg");
                                    clicked => {
                                        root.label-editing = -1;
                                        root.label-name = TasksUi.label-query;
                                        root.label-hex = "#4a86e8";
                                        root.label-colour = #4a86e8;
                                        root.label-edit-open = true;
                                    }
                                }
                            }
                            if root.label-edit-open : VerticalLayout {
                                padding: 8px;
                                spacing: 8px;
                                HorizontalLayout {
                                    height: 28px;
                                    spacing: 8px;
                                    Image {
                                        width: 16px;
                                        source: @image-url("../icons/lucide/filled/tag.svg");
                                        colorize: root.label-colour;
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: root.label-editing >= 0 ? @tr("Edit label") : @tr("Create label");
                                        color: AppTheme.heading;
                                        font-size: TypeScale.subtitle;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                                label-name-field := LineEdit {
                                    height: 36px;
                                    text <=> root.label-name;
                                    focus-on-show: true;
                                    placeholder-text: @tr("Label name");
                                    input-label: @tr("Label name");
                                    accepted(text) => {
                                        if text.character-count > 0 {
                                            TasksUi.command("label-save", "" + TasksUi.detail.id, root.label-editing + "|" + root.label-hex + "|" + text);
                                            root.label-edit-open = false;
                                label-popup.close();
                                        }
                                    }
                                }
                                TasksSwatches {
                                    selected-hex: root.label-hex;
                                    picked(hex) => { root.label-hex = hex; }
                                    picked-colour(c) => { root.label-colour = c; }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    height: 34px;
                                    Button {
                                        text: @tr("Save");
                                        primary: true;
                                        horizontal-stretch: 1;
                                        clicked => {
                                            if root.label-name.character-count > 0 {
                                                TasksUi.command("label-save", "" + TasksUi.detail.id, root.label-editing + "|" + root.label-hex + "|" + root.label-name);
                                                root.label-edit-open = false;
                                label-popup.close();
                                            }
                                        }
                                    }
                                    Button {
                                        text: @tr("Cancel");
                                        horizontal-stretch: 1;
                                        clicked => { root.label-edit-open = false; }
                                    }
                                    if root.label-editing >= 0 : Button {
                                        text: @tr("Delete");
                                        destructive: true;
                                        horizontal-stretch: 1;
                                        clicked => {
                                            TasksUi.command("label-delete", "", "" + root.label-editing);
                                            root.label-edit-open = false;
                                label-popup.close();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                for label[i] in TasksUi.label-rows : Rectangle {
                    x: i < parent.flow.length ? parent.flow[i].x : 0px;
                    y: i < parent.flow.length ? parent.flow[i].y : 0px;
                    height: 28px;
                    visible: label.applied;
                    width: label.applied ? label-text.preferred-width + 30px : 0px;
                    border-radius: 6px;
                    background: label.colour.with-alpha(0.22);
                    Image {
                        x: 7px;
                        y: (parent.height - self.height) / 2;
                        width: 12px;
                        height: 12px;
                        source: @image-url("../icons/lucide/filled/tag.svg");
                        colorize: label.colour;
                    }
                    label-text := Text {
                        x: 23px;
                        width: self.preferred-width;
                        height: parent.height;
                        text: label.name;
                        color: AppTheme.heading;
                        font-size: TypeScale.caption;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                if TasksUi.detail-labels.length == 0 : Text {
                    x: 34px;
                    y: 0px;
                    height: 28px;
                    text: @tr("No labels");
                    color: AppTheme.secondary;
                    font-size: TypeScale.caption;
                    vertical-alignment: center;
                }
            }
            // Property tiles: two columns, small label over a bold value (mockup 2).
            Rectangle {
                height: 7 * 40px + 6 * 6px;
                for prop[k] in [
                    { name: @tr("Status"), value: TasksUi.detail.column, icon: TasksText.column-icon(TasksUi.detail.column-icon) },
                    { name: @tr("Due"), value: TasksUi.detail.due != "" ? TasksUi.detail.due : "-", icon: @image-url("../icons/lucide/outline/calendar.svg") },
                    { name: @tr("Start"), value: TasksUi.detail.start != "" ? TasksUi.detail.start : "-", icon: @image-url("../icons/lucide/outline/calendar.svg") },
                    { name: @tr("Project"), value: TasksUi.detail.project, icon: @image-url("../icons/lucide/filled/project-dot.svg") },
                    { name: @tr("Context"), value: TasksUi.detail.context != "" ? TasksUi.detail.context : @tr("No context"), icon: @image-url("../icons/lucide/outline/file-directory.svg") },
                    { name: @tr("Assignee"), value: TasksUi.detail.assignee != "" ? TasksUi.detail.assignee : @tr("Unassigned"), icon: @image-url("../icons/lucide/outline/people.svg") },
                    { name: @tr("Progress"), value: TasksUi.detail.percent >= 0 ? TasksUi.detail.percent + "%" : @tr("Automatic"), icon: @image-url("../icons/lucide/outline/check-circle.svg") },
                ] : Rectangle {
                    x: 0px;
                    y: k * 46px;
                    width: parent.width;
                    height: 40px;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: AppTheme.border;
                    background: AppTheme.sidebar-bg;
                    Image {
                        x: 12px;
                        y: (parent.height - 18px) / 2;
                        width: 18px;
                        height: 18px;
                        source: prop.icon;
                        colorize: AppTheme.secondary;
                    }
                    Text {
                        x: 40px;
                        y: 0px;
                        width: min(96px, (parent.width - 40px - 36px) / 2);
                        height: parent.height;
                        text: prop.name;
                        color: AppTheme.muted;
                        font-size: TypeScale.caption;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        x: 40px + min(96px, (parent.width - 40px - 36px) / 2) + 8px;
                        y: 0px;
                        width: parent.width - self.x - 36px;
                        height: parent.height;
                        text: prop.value;
                        color: AppTheme.heading;
                        font-size: TypeScale.body;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    // The whole tile opens the same menu as the "…" button.
                    TouchArea {
                        accessible-role: none;
                        mouse-cursor: pointer;
                        clicked => { tile-menu.open-menu(); }
                    }
                    tile-menu := ActionMenu {
                        x: parent.width - 30px;
                        y: (parent.height - 26px) / 2;
                        width: 26px;
                        height: 26px;
                        icon: @image-url("../icons/lucide/outline/kebab-horizontal.svg");
                    entries: k == 0 ? TasksUi.card-menu
                            : (k == 1 || k == 2) ? [
                                    { id: "today", title: @tr("Today") },
                                    { id: "tomorrow", title: @tr("Tomorrow") },
                                    { id: "week", title: @tr("In a week") },
                                    { id: "none", title: @tr("No date") },
                                    { id: "pick", title: @tr("Pick a date") },
                                ]
                                : k == 3 ? TasksUi.project-menu
                                : k == 4 ? TasksUi.context-menu
                                : k == 5 ? TasksUi.assignee-menu
                                : [
                                    { id: "auto", title: (TasksUi.detail.percent < 0 ? "✓ " : "") + @tr("Automatic (from the checklist)") },
                                    { id: "0", title: (TasksUi.detail.percent == 0 ? "✓ " : "") + "0%" },
                                    { id: "10", title: (TasksUi.detail.percent == 10 ? "✓ " : "") + "10%" },
                                    { id: "20", title: (TasksUi.detail.percent == 20 ? "✓ " : "") + "20%" },
                                    { id: "25", title: (TasksUi.detail.percent == 25 ? "✓ " : "") + "25%" },
                                    { id: "30", title: (TasksUi.detail.percent == 30 ? "✓ " : "") + "30%" },
                                    { id: "40", title: (TasksUi.detail.percent == 40 ? "✓ " : "") + "40%" },
                                    { id: "50", title: (TasksUi.detail.percent == 50 ? "✓ " : "") + "50%" },
                                    { id: "60", title: (TasksUi.detail.percent == 60 ? "✓ " : "") + "60%" },
                                    { id: "70", title: (TasksUi.detail.percent == 70 ? "✓ " : "") + "70%" },
                                    { id: "75", title: (TasksUi.detail.percent == 75 ? "✓ " : "") + "75%" },
                                    { id: "80", title: (TasksUi.detail.percent == 80 ? "✓ " : "") + "80%" },
                                    { id: "90", title: (TasksUi.detail.percent == 90 ? "✓ " : "") + "90%" },
                                    { id: "100", title: (TasksUi.detail.percent == 100 ? "✓ " : "") + "100%" },
                                ];
                        menu-width: 220px;
                        tooltip-text: prop.name;
                            activated(id) => {
                                if k == 0 {
                                    TasksUi.command("card-menu", "" + TasksUi.detail.id, id);
                                } else if k == 1 || k == 2 {
                                    if id == "pick" {
                                        root.picker-for = k == 1 ? "due" : "start";
                                        TasksUi.command("picker", "", "");
                                    } else {
                                        TasksUi.command(k == 1 ? "detail-due" : "detail-start", "" + TasksUi.detail.id, id);
                                    }
                                } else if k == 3 {
                                    TasksUi.command("project-menu", "" + TasksUi.detail.id, id);
                                } else if k == 4 {
                                    TasksUi.command("detail-context", "" + TasksUi.detail.id, id);
                                } else if k == 6 {
                                    TasksUi.command("detail-percent", "" + TasksUi.detail.id, id);
                                } else {
                                    if id == "find" {
                                        root.assignee-open = true;
                                    } else {
                                        TasksUi.command("detail-assignee", "" + TasksUi.detail.id, id == "me" ? "me" : id == "none" ? "" : id);
                                    }
                                }
                            }
                    }
                }
            }
            if TasksUi.picker-open : Rectangle {
                height: 6 * 30px + 40px + 40px;
                border-radius: LayoutMetrics.corner-radius;
                background: AppTheme.sidebar-bg;
                for day[i] in TasksUi.picker-days : Rectangle {
                    x: 8px + mod(i, 7) * ((parent.width - 16px) / 7);
                    y: 36px + floor(i / 7) * 30px;
                    width: (parent.width - 16px) / 7;
                    height: 30px;
                    border-radius: 6px;
                    background: day.selected ? AppTheme.accent : day.today ? AppTheme.accent-soft : transparent;
                    Text {
                        text: day.label;
                        color: day.selected ? #ffffff : day.in-month ? AppTheme.heading : AppTheme.secondary;
                        font-size: TypeScale.caption;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        accessible-role: button;
                        accessible-label: day.date;
                        clicked => {
                            TasksUi.command(root.picker-for == "start" ? "detail-start" : "detail-due", "" + TasksUi.detail.id, day.date);
                            TasksUi.command("picker", "", "close");
                        }
                    }
                }
                TasksIconButton {
                    x: 6px;
                    y: 4px;
                    width: 28px;
                    height: 28px;
                    icon: @image-url("../icons/lucide/outline/chevron-left.svg");
                    tooltip-text: @tr("Previous month");
                    clicked => { TasksUi.command("picker", "", "prev:" + TasksUi.picker-month); }
                }
                Text {
                    x: 36px;
                    y: 4px;
                    width: parent.width - 72px;
                    height: 28px;
                    text: TasksUi.picker-title;
                    color: AppTheme.heading;
                    font-size: TypeScale.body;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TasksIconButton {
                    x: parent.width - 34px;
                    y: 4px;
                    width: 28px;
                    height: 28px;
                    icon: @image-url("../icons/lucide/outline/chevron-right.svg");
                    tooltip-text: @tr("Next month");
                    clicked => { TasksUi.command("picker", "", "next:" + TasksUi.picker-month); }
                }
                Button {
                    x: 8px;
                    y: 6 * 30px + 40px;
                    width: parent.width - 16px;
                    height: 32px;
                    text: @tr("Close");
                    clicked => { TasksUi.command("picker", "", "close"); }
                }
                picker-keys := FocusScope {
                    width: 0px;
                    height: 0px;
                    key-pressed(event) => {
                        if event.text == Key.Escape {
                            TasksUi.command("picker", "", "close");
                            return accept;
                        }
                        return reject;
                    }
                }
                init => { picker-keys.focus(); }
            }
            if root.assignee-open : VerticalLayout {
                spacing: 10px;
                HorizontalLayout {
                    spacing: 6px;
                    DetailSection { horizontal-stretch: 1; text: @tr("ASSIGNEE"); }
                    Button {
                        text: @tr("Done");
                        width: max(72px, self.content-width + 28px);
                        clicked => { root.assignee-open = false; }
                    }
                }
            HorizontalLayout {
                spacing: 6px;
                height: 34px;
                LineEdit {
                    horizontal-stretch: 1;
                    text <=> root.assignee-draft;
                    placeholder-text: @tr("Name or email, empty to clear");
                    input-label: @tr("Assignee");
                    edited(text) => { TasksUi.command("assignee-suggest", text, ""); }
                    accepted(text) => {
                        TasksUi.command("detail-assignee", "" + TasksUi.detail.id, text);
                        root.assignee-open = false;
                        root.assignee-draft = "";
                        TasksUi.assignee-suggestions = [];
                    }
                }
                Button {
                    text: @tr("Me");
                    width: max(56px, self.content-width + 28px);
                    clicked => {
                        TasksUi.command("detail-assignee", "" + TasksUi.detail.id, "me");
                        root.assignee-open = false;
                    }
                }
            }
            for other in TasksUi.co-assignees : HorizontalLayout {
                height: 26px;
                spacing: 6px;
                Text {
                    horizontal-stretch: 1;
                    text: other.title;
                    color: AppTheme.body;
                    font-size: TypeScale.secondary;
                    vertical-alignment: center;
                    overflow: elide;
                }
                TasksIconButton {
                    width: 22px;
                    height: 22px;
                    icon: @image-url("../icons/lucide/outline/x.svg");
                    tooltip-text: @tr("Remove");
                    clicked => { TasksUi.command("co-assignee-remove", "" + TasksUi.detail.id, other.id); }
                }
            }
            LineEdit {
                placeholder-text: @tr("Add another person");
                input-label: @tr("Add another person");
                accepted(text) => {
                    TasksUi.command("co-assignee-add", "" + TasksUi.detail.id, text);
                    self.text = "";
                    root.assignee-open = false;
                }
            }
            for person in TasksUi.assignee-suggestions : Rectangle {
                height: 28px;
                background: person-touch.has-hover ? AppTheme.sidebar-bg : transparent;
                border-radius: 4px;
                Text {
                    x: 8px;
                    width: parent.width - 16px;
                    height: parent.height;
                    text: person.title;
                    color: AppTheme.body;
                    font-size: TypeScale.secondary;
                    vertical-alignment: center;
                    overflow: elide;
                }
                person-touch := TouchArea {
                    accessible-role: button;
                    accessible-label: person.title;
                    mouse-cursor: pointer;
                    clicked => {
                        TasksUi.command("detail-assignee", "" + TasksUi.detail.id, person.id);
                        root.assignee-open = false;
                        root.assignee-draft = "";
                        TasksUi.assignee-suggestions = [];
                    }
                }
            }
            }
            DetailSection { text: @tr("DESCRIPTION"); }
            // Plain text, as in the mockup; a click turns it into an editor.
            if !root.desc-editing : Rectangle {
                height: max(34px, desc-text.preferred-height + 12px);
                border-radius: 6px;
                background: desc-touch.has-hover ? AppTheme.sidebar-bg : transparent;
                desc-text := Text {
                    x: 6px;
                    y: 6px;
                    width: parent.width - 12px;
                    height: self.preferred-height;
                    text: root.description-draft != "" ? root.description-draft : @tr("Add a description");
                    color: root.description-draft != "" ? AppTheme.body : AppTheme.muted;
                    font-size: TypeScale.body;
                    wrap: word-wrap;
                }
                desc-touch := TouchArea {
                    accessible-role: button;
                    accessible-label: @tr("Add a description");
                    mouse-cursor: text;
                    clicked => { root.desc-editing = true; }
                }
            }
            if root.desc-editing : TextEdit {
                height: 110px;
                text <=> root.description-draft;
                placeholder-text: @tr("Add a description");
            }
            if root.desc-editing : Button {
                text: @tr("Save");
                width: max(100px, self.content-width + 28px);
                clicked => {
                    TasksUi.save-detail("" + TasksUi.detail.id, root.title-draft, root.description-draft, root.due-draft);
                    root.desc-editing = false;
                }
            }
            HorizontalLayout {
                spacing: 6px;
                DetailSection {
                    horizontal-stretch: 1;
                    text: TasksUi.checklist.length > 0 ? @tr("CHECKLIST") + " · " + TasksUi.checklist-done + " / " + TasksUi.checklist.length : @tr("CHECKLIST");
                }
                Button {
                    text: root.check-adding ? @tr("Done") : "+";
                    accessible-label: root.check-adding ? @tr("Done") : @tr("Add checklist item");
                    width: root.check-adding ? max(72px, self.content-width + 28px) : 36px;
                    clicked => { root.check-adding = !root.check-adding; }
                }
            }
            for item in TasksUi.checklist : HorizontalLayout {
                spacing: 6px;
                TasksIconButton {
                    width: 26px;
                    height: 26px;
                    icon: item.done ? @image-url("../icons/lucide/filled/tasks.svg") : @image-url("../icons/lucide/outline/tasks.svg");
                    icon-color: item.done ? AppTheme.accent : AppTheme.secondary;
                    tooltip-text: item.done ? @tr("Uncheck item") : @tr("Check item");
                    clicked => { TasksUi.command("check-toggle", "" + item.id, item.done ? "0" : "1"); }
                }
                Text {
                    horizontal-stretch: 1;
                    text: item.done && item.struck != "" ? item.struck : item.text;
                    color: item.done ? AppTheme.muted : AppTheme.body;
                    font-size: TypeScale.body;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
                TasksIconButton {
                    width: 26px;
                    height: 26px;
                    icon: @image-url("../icons/lucide/outline/x.svg");
                    tooltip-text: @tr("Remove item");
                    clicked => { TasksUi.command("check-delete", "" + item.id, ""); }
                }
            }
            if root.check-adding : LineEdit {
                placeholder-text: @tr("Add checklist item");
                input-label: @tr("Add checklist item");
                accepted(text) => { TasksUi.command("check-add", "" + TasksUi.detail.id, text); self.text = ""; }
            }
            HorizontalLayout {
                spacing: 6px;
                DetailSection {
                    horizontal-stretch: 1;
                    text: TasksUi.links.length > 0 ? @tr("LINKED ITEMS") + " · " + TasksUi.links.length : @tr("LINKED ITEMS");
                }
                Button {
                    text: root.link-adding ? @tr("Done") : "+";
                    accessible-label: root.link-adding ? @tr("Done") : @tr("Add a link");
                    width: root.link-adding ? max(72px, self.content-width + 28px) : 36px;
                    clicked => { root.link-adding = !root.link-adding; }
                }
            }
            for link in TasksUi.links : Rectangle {
                border-radius: 8px;
                border-width: 1px;
                border-color: AppTheme.border;
                background: AppTheme.sidebar-bg;
                HorizontalLayout {
                padding: 8px;
                spacing: 8px;
                Rectangle {
                    width: 28px;
                    height: 28px;
                    y: 0px;
                    border-radius: 6px;
                    background: AppTheme.accent-soft;
                    Image {
                        x: 6px;
                        y: 6px;
                        width: 16px;
                        height: 16px;
                        source: link.kind == "mail_received" ? @image-url("../icons/lucide/outline/mail.svg")
                            : link.kind == "mail_sent" ? @image-url("../icons/lucide/outline/paper-airplane.svg")
                            : link.kind == "event" ? @image-url("../icons/lucide/outline/calendar.svg")
                            : @image-url("../icons/lucide/outline/link.svg");
                        colorize: AppTheme.accent;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text {
                        text: link.kind == "mail_received" ? @tr("Mail")
                            : link.kind == "mail_sent" ? @tr("Sent")
                            : link.kind == "event" ? @tr("Event")
                            : link.kind == "task_blocks" ? @tr("Blocks")
                            : @tr("Depends on");
                        color: AppTheme.muted;
                        font-size: TypeScale.micro;
                    }
                    if link.note == "done" || link.note == "open" : Text {
                        text: link.note == "done" ? @tr("Done") : @tr("Open");
                        color: link.note == "done" ? AppTheme.accent : AppTheme.secondary;
                        font-size: TypeScale.micro;
                        font-weight: 700;
                    }
                    Text {
                        text: link.found ? link.text : @tr("Not found");
                        color: link.found ? AppTheme.heading : AppTheme.destructive;
                        font-size: TypeScale.body;
                        font-weight: 600;
                        wrap: word-wrap;
                        if link.open != "" : TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if link.thread-id >= 0 {
                                    TasksUi.command("open-mail", "" + link.thread-id, link.text);
                                } else {
                                    TasksUi.command("open", link.open, "");
                                }
                            }
                        }
                    }
                    if link.kind == "mail_sent" && TasksUi.detail.waiting-days >= 0 : TaskPill {
                        text: @tr("Awaiting reply · {}d", TasksUi.detail.waiting-days);
                        tone: AppTheme.destructive;
                    }
                    if link.kind == "mail_sent" && TasksUi.detail.follow-up != "" && !TasksUi.detail.done : HorizontalLayout {
                        spacing: 4px;
                        alignment: start;
                        Image {
                            y: (parent.height - 11px) / 2;
                            width: 11px;
                            height: 11px;
                            source: @image-url("../icons/lucide/outline/history.svg");
                            colorize: AppTheme.secondary;
                        }
                        Text {
                            text: @tr("Follow up {}", TasksUi.detail.follow-up);
                            color: AppTheme.secondary;
                            font-size: TypeScale.micro;
                        }
                    }
                    if link.note != "" && link.note != "done" && link.note != "open" : Text {
                        text: link.note;
                        color: AppTheme.muted;
                        font-size: TypeScale.micro;
                    }
                }
                TasksIconButton {
                    width: 22px;
                    height: 22px;
                    icon: @image-url("../icons/lucide/outline/x.svg");
                    tooltip-text: @tr("Remove link");
                    clicked => { TasksUi.command("link-remove", "" + link.id, ""); }
                }
                }
            }
            if root.link-adding : HorizontalLayout {
                height: 34px;
                spacing: 6px;
                LineEdit {
                    horizontal-stretch: 1;
                    text <=> root.link-draft;
                    placeholder-text: root.link-kind == "blocks" ? @tr("Blocks task (title)")
                        : root.link-kind == "event" ? @tr("Calendar event (title)")
                        : root.link-kind == "mail" ? @tr("Mail (subject)")
                        : @tr("Depends on task (title)");
                    input-label: @tr("Link a task, event or mail");
                    accepted(text) => {
                        TasksUi.command("link-task", "" + TasksUi.detail.id, root.link-kind + ":" + text);
                        root.link-draft = "";
                    }
                }
                ActionMenu {
                    width: 34px;
                    height: 34px;
                    icon: @image-url("../icons/lucide/outline/kebab-horizontal.svg");
                    entries: [
                        { id: "depends", title: @tr("Depends on") },
                        { id: "blocks", title: @tr("Blocks") },
                        { id: "event", title: @tr("Calendar event") },
                        { id: "mail", title: @tr("Mail") },
                    ];
                    menu-width: 180px;
                    tooltip-text: @tr("Link type");
                    activated(id) => { root.link-kind = id; }
                }
            }
            DetailSection { text: TasksUi.detail-expanded ? @tr("LINK TRAIL") : @tr("ACTIVITY"); visible: TasksUi.activity.length > 0; height: self.visible ? self.preferred-height : 0px; }
            VerticalLayout {
                spacing: 0px;
                PendingTrail { }
                for entry[index] in TasksUi.activity : HorizontalLayout {
                    spacing: 10px;
                    TrailMarker {
                        kind: entry.kind;
                        first: index == 0 && !TasksUi.trail-pending;
                        last: index == TasksUi.activity.length - 1;
                    }
                    VerticalLayout {
                        padding-bottom: 14px;
                        spacing: 1px;
                        Text {
                            text: entry.text;
                            color: AppTheme.body;
                            font-size: TypeScale.caption;
                            wrap: word-wrap;
                        }
                        Text {
                            text: entry.at;
                            color: AppTheme.muted;
                            font-size: TypeScale.micro;
                        }
                    }
                }
            }
            Button {
                text: @tr("Delete task");
                destructive: true;
                width: max(120px, self.content-width + 28px);
                clicked => { TasksUi.command("delete", "" + TasksUi.detail.id, ""); }
            }
          }
        }
    }

    // Actions stay in view under the scrolling content, as in the mockup.
    Rectangle {
        x: 1px;
        y: parent.height - root.footer-height;
        width: parent.width - 1px;
        height: root.footer-height;
        background: AppTheme.surface;
        Rectangle { x: 0px; y: 0px; height: LayoutMetrics.divider-width; background: AppTheme.border; }
        VerticalLayout {
            x: 16px;
            y: 0px;
            width: min(640px, parent.width - 32px - root.dock-reserve);
            height: parent.height;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 8px;
            alignment: center;
        HorizontalLayout {
            spacing: 8px;
            Button {
                text: TasksUi.detail.waiting-days >= 0 ? @tr("Follow up") : TasksUi.detail.reply-thread >= 0 ? @tr("Reply from task") : @tr("Email");
                primary: !TasksUi.detail.done;
                horizontal-stretch: 1;
                clicked => {
                    if TasksUi.detail.reply-thread >= 0 && TasksUi.detail.waiting-days < 0 {
                        TasksUi.command("reply-mail", TasksUi.detail.reply-thread + ":" + TasksUi.detail.id, TasksUi.detail.reply-subject);
                    } else {
                        TasksUi.email-task(TasksUi.detail.id, TasksUi.detail.title);
                    }
                }
            }
            Button {
                text: @tr("Schedule");
                horizontal-stretch: 1;
                clicked => { TasksUi.command("picker", "", ""); }
            }
        }
        if TasksUi.links.length > 0 : Button {
            text: @tr("Move back when a reply arrives");
            selected: TasksUi.detail.move-back;
            label-overflow: elide;
            clicked => { TasksUi.command("toggle-move-back", "" + TasksUi.detail.id, ""); }
        }
        HorizontalLayout {
            spacing: 8px;
            Button {
                text: TasksUi.detail.done ? @tr("Reopen") : @tr("Complete");
                horizontal-stretch: 1;
                clicked => { TasksUi.command(TasksUi.detail.done ? "reopen" : "complete", "" + TasksUi.detail.id, ""); }
            }
            Button {
                text: @tr("High priority");
                selected: TasksUi.detail.high-priority;
                horizontal-stretch: 1;
                clicked => { TasksUi.command("toggle-priority", "" + TasksUi.detail.id, ""); }
            }
        }
        }
    }
}

export component TasksView inherits Rectangle {
    in property <bool> compact: false;
    in property <bool> active: true;
    private property <bool> single-surface: root.compact;
    private property <bool> board-visible: !root.single-surface || !TasksUi.navigation-open;
    private property <bool> sidebar-visible: !root.single-surface && !TasksUi.sidebar-collapsed;
    background: AppTheme.page-bg;

    changed active => {
        if !root.active { TasksUi.adding-column = -2; TasksUi.creating = ""; }
    }

    if root.sidebar-visible || (root.single-surface && TasksUi.navigation-open) : CollapsibleWorkspaceSidebar {
        x: 0px;
        y: 0px;
        height: parent.height;
        width: root.single-surface ? parent.width : LayoutMetrics.sidebar-width;
        TasksSidebar {
            width: parent.width;
            height: parent.height;
            navigate(key) => {
                TasksUi.navigation-open = false;
                TasksUi.command("select", key, "");
            }
            new-task => {
                TasksUi.navigation-open = false;
                TasksUi.adding-column = TasksUi.columns.length > 0 ? TasksUi.columns[0].id : -1;
            }
        }
    }

    private property <length> drawer-width: root.single-surface ? root.width
        : TasksUi.detail-expanded ? root.width - (root.sidebar-visible ? LayoutMetrics.sidebar-width : 0px)
        : 392px;
    private property <bool> drawer-visible: TasksUi.detail-open && !TasksUi.navigation-open;

    if root.board-visible && !(root.single-surface && root.drawer-visible) : Rectangle {
        x: root.sidebar-visible ? LayoutMetrics.sidebar-width : 0px;
        width: parent.width - self.x - (root.drawer-visible ? root.drawer-width : 0px);
        height: parent.height;

        VerticalLayout {
            padding: LayoutMetrics.content-inset;
            spacing: 10px;
            HorizontalLayout {
                height: 40px;
                // Tooltips hang below the toolbar rows, over the board.
                z: 30;
                spacing: 8px;
                TasksIconButton {
                    width: 36px;
                    icon: TasksUi.sidebar-collapsed || root.single-surface
                        ? @image-url("../icons/lucide/outline/sidebar-expand.svg")
                        : @image-url("../icons/lucide/outline/sidebar-collapse.svg");
                    tooltip-text: @tr("Lists");
                    clicked => {
                        if root.single-surface { TasksUi.navigation-open = true; }
                        else { TasksUi.sidebar-collapsed = !TasksUi.sidebar-collapsed; }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text {
                        text: TasksUi.title != "" ? TasksUi.title : TasksText.focus-label(TasksUi.selection);
                        color: AppTheme.title;
                        font-size: TypeScale.heading-small;
                        font-weight: 700;
                        overflow: elide;
                    }
                    Text {
                        text: @tr("{} tasks", TasksUi.task-count) + " · " + TasksUi.week-label;
                        color: AppTheme.secondary;
                        font-size: TypeScale.micro;
                    }
                }
                LineEdit {
                    width: root.single-surface ? 150px : 280px;
                    height: 34px;
                    show-leading-icon: true;
                    leading-icon: @image-url("../icons/lucide/outline/search.svg");
                    placeholder-text: @tr("Search tasks and linked mail");
                    input-label: @tr("Search tasks and linked mail");
                    text: TasksUi.query;
                    edited(text) => { TasksUi.command("search", text, ""); }
                }
            }
            HorizontalLayout {
                height: 30px;
                z: 30;
                spacing: 8px;
                for chip in TasksUi.filter-chips : Rectangle {
                    width: chip-text.preferred-width + 40px;
                    height: 28px;
                    border-radius: 14px;
                    background: AppTheme.selected-row;
                    chip-text := Text {
                        x: 10px;
                        width: self.preferred-width;
                        height: parent.height;
                        text: chip.text;
                        color: AppTheme.title;
                        font-size: TypeScale.caption;
                        vertical-alignment: center;
                    }
                    TasksIconButton {
                        x: parent.width - 26px;
                        y: 3px;
                        width: 22px;
                        height: 22px;
                        icon: @image-url("../icons/lucide/outline/x.svg");
                        tooltip-text: @tr("Remove filter");
                        clicked => { TasksUi.command("filter-remove", chip.key, ""); }
                    }
                }
                // Projects offer Board, List and Timeline; the other lists offer
                // List and Timeline. The switch never disappears.
                if TasksUi.can-switch-view : Button {
                    height: 28px;
                    text: @tr("Board");
                    width: max(64px, self.content-width + 24px);
                    primary: !TasksUi.list-mode && !TasksUi.timeline-mode;
                    clicked => { TasksUi.command("view", "board", ""); }
                }
                Button {
                    height: 28px;
                    text: @tr("List");
                    width: max(64px, self.content-width + 24px);
                    primary: TasksUi.can-switch-view ? TasksUi.list-mode : !TasksUi.timeline-mode;
                    clicked => { TasksUi.command("view", "list", ""); }
                }
                Button {
                    height: 28px;
                    text: @tr("Timeline");
                    width: max(72px, self.content-width + 24px);
                    primary: TasksUi.timeline-mode;
                    clicked => { TasksUi.command("view", "timeline", ""); }
                }
                if TasksUi.can-switch-view : ActionMenu {
                    width: 28px;
                    height: 28px;
                    icon: @image-url("../icons/lucide/outline/gear.svg");
                    entries: [
                        { id: "completed", title: (TasksUi.show-completed ? "✓ " : "") + @tr("Show completed tasks") },
                        { id: "compact", title: (TasksUi.compact-cards ? "✓ " : "") + @tr("Compact cards") },
                        { id: "collapse-empty", title: @tr("Collapse empty columns") },
                    ];
                    menu-width: 240px;
                    align-right: false;
                    tooltip-text: @tr("Display");
                    activated(id) => {
                        if id == "collapse-empty" {
                            TasksUi.command("collapse-empty", "", "");
                        } else {
                            TasksUi.command("display", id, "");
                        }
                    }
                }
                // On the board the grouping is the columns (status); any other
                // choice shows the open tasks as a grouped list.
                if TasksUi.can-switch-view && !TasksUi.timeline-mode && TasksUi.group-menu.length == 0 : ActionMenu {
                    width: 28px;
                    height: 28px;
                    icon: @image-url("../icons/lucide/outline/list-unordered.svg");
                    entries: [
                        { id: "status", title: "✓ " + TasksUi.group-title("status") },
                        { id: "context", title: TasksUi.group-title("context") },
                        { id: "label", title: TasksUi.group-title("label") },
                        { id: "due", title: TasksUi.group-title("due") },
                    ];
                    menu-width: 220px;
                    align-right: false;
                    tooltip-text: @tr("Group");
                    activated(id) => { TasksUi.command("board-group", id, ""); }
                }
                if TasksUi.group-menu.length > 0 : ActionMenu {
                    width: 28px;
                    height: 28px;
                    icon: @image-url("../icons/lucide/outline/list-unordered.svg");
                    entries: TasksUi.group-menu;
                    menu-width: 220px;
                    align-right: false;
                    tooltip-text: @tr("Group");
                    activated(id) => { TasksUi.command("group", id, ""); }
                }
                if TasksUi.filter-menu.length > 0 : ActionMenu {
                    width: 28px;
                    height: 28px;
                    icon: @image-url("../icons/lucide/outline/list-filter-plus.svg");
                    entries: TasksUi.filter-menu;
                    menu-width: 240px;
                    align-right: false;
                    tooltip-text: @tr("Add filter");
                    activated(id) => { TasksUi.command("filter-add", id, ""); }
                }
                if TasksUi.can-switch-view : ActionMenu {
                    width: 28px;
                    height: 28px;
                    icon: @image-url("../icons/lucide/outline/kebab-horizontal.svg");
                    entries: [
                        { id: "rename", title: @tr("Rename project") },
                        { id: "add-column", title: @tr("Add column") },
                        { id: "delete", title: @tr("Delete project") },
                        { id: "colour:#6b7280", title: @tr("Colour: Grey") },
                        { id: "colour:#3b82f6", title: @tr("Colour: Blue") },
                        { id: "colour:#22c55e", title: @tr("Colour: Green") },
                        { id: "colour:#f59e0b", title: @tr("Colour: Orange") },
                        { id: "colour:#ef4444", title: @tr("Colour: Red") },
                        { id: "custom-colour", title: @tr("Custom colour…") },
                    ];
                    menu-width: 220px;
                    align-right: false;
                    tooltip-text: @tr("Project options");
                    activated(id) => {
                        if (id.starts-with("colour:")) {
                            TasksUi.command("project-colour", "", id);
                        } else {
                            TasksUi.creating = id == "rename" ? "rename-project" : id == "add-column" ? "column-project" : id == "custom-colour" ? "colour-project" : "delete-project";
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: TasksUi.today-label + " · " + @tr("GTD workflow");
                    color: AppTheme.secondary;
                    font-size: TypeScale.caption;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            if TasksUi.creating == "rename-project" && TasksUi.can-switch-view : LineEdit {
                text: TasksUi.title;
                placeholder-text: @tr("Project name");
                input-label: @tr("Project name");
                accepted(text) => { TasksUi.command("project-rename", text, ""); TasksUi.creating = ""; }
            }
            if TasksUi.creating == "column-project" && TasksUi.can-switch-view : LineEdit {
                placeholder-text: @tr("Column name");
                input-label: @tr("Column name");
                accepted(text) => { TasksUi.command("add-column", text, ""); TasksUi.creating = ""; }
            }
            if TasksUi.creating == "colour-project" && TasksUi.can-switch-view : LineEdit {
                placeholder-text: @tr("Colour as #rrggbb");
                input-label: @tr("Colour as #rrggbb");
                accepted(text) => { TasksUi.command("project-colour", "", "colour:" + text); TasksUi.creating = ""; }
            }
            if TasksUi.creating == "colour-project" && TasksUi.can-switch-view : TasksSwatches {
                picked(hex) => { TasksUi.command("project-colour", "", "colour:" + hex); TasksUi.creating = ""; }
            }
            if TasksUi.creating == "delete-project" && TasksUi.can-switch-view : HorizontalLayout {
                height: 32px;
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: @tr("Delete this project and its tasks?");
                    color: AppTheme.destructive;
                    font-size: TypeScale.secondary;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Button {
                    text: @tr("Delete");
                    width: max(80px, self.content-width + 28px);
                    clicked => { TasksUi.command("project-delete", "", ""); TasksUi.creating = ""; }
                }
                Button {
                    text: @tr("Cancel");
                    width: max(80px, self.content-width + 28px);
                    clicked => { TasksUi.creating = ""; }
                }
            }
            if TasksUi.status != "" : Text {
                text: TasksUi.status;
                color: AppTheme.destructive;
                font-size: TypeScale.caption;
                wrap: word-wrap;
            }
            if TasksUi.timeline-mode : TasksTimeline {
                vertical-stretch: 1;
            }
            if TasksUi.columns.length == 0 && !TasksUi.loading && !TasksUi.timeline-mode : DetailEmptyState {
                vertical-stretch: 1;
                title: @tr("No tasks");
            }
            // The flat lists have a header row: a click orders by that column, a
            // second click reverses it.
            if TasksUi.group-menu.length > 0 : HorizontalLayout {
                height: 28px;
                spacing: 6px;
                for column[i] in [
                    { token: "title", text: @tr("Title") },
                    { token: "due", text: @tr("Due") },
                    { token: "priority", text: @tr("Priority") },
                ] : Rectangle {
                    width: max(72px, header-text.preferred-width + 28px);
                    border-radius: 6px;
                    background: header-touch.has-hover ? AppTheme.sidebar-bg : transparent;
                    header-text := Text {
                        x: 10px;
                        y: (parent.height - self.height) / 2;
                        text: column.text + (TasksUi.sort == column.token ? " ↑"
                            : TasksUi.sort == column.token + "-reversed" ? " ↓" : "");
                        color: TasksUi.sort == column.token || TasksUi.sort == column.token + "-reversed" ? AppTheme.heading : AppTheme.secondary;
                        font-size: TypeScale.caption;
                        font-weight: 600;
                    }
                    header-touch := TouchArea {
                        accessible-role: button;
                        accessible-label: @tr("Sort by {}", column.text);
                        mouse-cursor: pointer;
                        clicked => { TasksUi.command("group", "sort:" + column.token, ""); }
                    }
                }
            }
            if !TasksUi.timeline-mode : board-focus := FocusScope {
              vertical-stretch: 1;
              accessible-role: list;
              accessible-label: @tr("Task board");
              changed has-focus => { TasksUi.board-focused = self.has-focus; }
              key-pressed(event) => {
                if event.text == Key.UpArrow { TasksUi.command("board-key", "up", ""); return accept; }
                if event.text == Key.DownArrow { TasksUi.command("board-key", "down", ""); return accept; }
                if event.text == Key.LeftArrow { TasksUi.command("board-key", "left", ""); return accept; }
                if event.text == Key.RightArrow { TasksUi.command("board-key", "right", ""); return accept; }
                if event.text == Key.Home { TasksUi.command("board-key", "home", ""); return accept; }
                if event.text == Key.End { TasksUi.command("board-key", "end", ""); return accept; }
                if event.text == Key.Return { TasksUi.command("board-key", "open", ""); return accept; }
                if event.text == " " { TasksUi.command("board-key", "toggle", ""); return accept; }
                return reject;
              }
            ScrollView {
                width: parent.width;
                height: parent.height;
                visible: TasksUi.columns.length > 0;
                content-height: self.visible-height;
                vertical-scrollbar-policy: always-off;
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    for column in TasksUi.columns : TaskColumnView {
                        column: column;
                        column-width: root.single-surface ? max(240px, root.width - 56px) : 272px;
                        card-used(id) => { TasksUi.cursor = id; board-focus.focus(); }
                    }
                    if TasksUi.selection.starts-with("project:") : Rectangle {
                        width: 220px;
                        VerticalLayout {
                            alignment: start;
                            padding-top: 10px;
                            if TasksUi.creating == "column" : LineEdit {
                                placeholder-text: @tr("Column name");
                                input-label: @tr("Column name");
                                accepted(text) => { TasksUi.command("add-column", text, ""); TasksUi.creating = ""; }
                            }
                            if TasksUi.creating != "column" : Button {
                                text: @tr("Add column");
                                has-icon: true;
                                label-overflow: elide;
                                icon: @image-url("../icons/lucide/outline/plus.svg");
                                clicked => { TasksUi.creating = "column"; }
                            }
                        }
                    }
                }
            }
            }
        }
    }

    if root.drawer-visible : TaskDrawer {
        x: parent.width - root.drawer-width;
        width: root.drawer-width;
        height: parent.height;
        compact: root.compact;
    }
}
